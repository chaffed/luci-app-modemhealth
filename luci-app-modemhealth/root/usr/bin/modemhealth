#!/bin/sh
# Modem Health: read a cable modem's status and keep it as evidence.
#
#   modemhealth check        read the modem once and store the reading
#   modemhealth history [N]  print the last N readings (default 12)
#   modemhealth last         print the latest stored reading
#   modemhealth logout       end the modem session kept between checks
#   modemhealth daemon       check on schedule (started by /etc/init.d/modemhealth)
#
# Supported modems: ARRIS/Vantiva SURFboard S33 and S34 (HNAP, HMAC-SHA256).
# The modem reader (the "modem_*" functions) only logs in and turns replies
# into lines; storage is separate, so other models can be added as readers.
#
# SPDX-License-Identifier: MIT
# shellcheck shell=dash

CONFIG=modemhealth
HNAP_NS='http://purenetworks.com/HNAP1/'
STATUS_ACTIONS='GetCustomerStatusStartupSequence GetCustomerStatusConnectionInfo GetCustomerStatusDownstreamChannelInfo GetCustomerStatusUpstreamChannelInfo GetCustomerStatusSoftware GetCustomerStatusLog'
# Stored per day, in DATA_DIR/readings/ and DATA_DIR/channels/ (see storage).
READINGS_HEADER='ts,result,reason,model,firmware,uptime_s,connectivity,boot,network_access,modem_time,ds_channels,us_channels,reboot,boot_ts,clock_offset_s'
EVENTS_HEADER='first_seen_ts,modem_time,clock_offset_s,level,message'
CHANNELS_HEADER='ts,dir,channel_id,lock,power_dbmv,snr_db,corrected,uncorrectable'
CHANNELMAP_HEADER='ts,dir,ch,channel_id,modulation,freq_hz,width_hz'

log() { logger -t modemhealth "$*" 2>/dev/null; [ -t 2 ] && echo "modemhealth: $*" >&2; return 0; }

# Text from the modem goes into CSV files and, later, web pages: keep it to
# printable characters without the CSV and HTML specials.
clean() { printf '%s' "$*" | tr -d '\000-\037",\\<>' | cut -c1-120; }

int_or() { case "$1" in ''|*[!0-9]*) echo "$2" ;; *) echo "$1" ;; esac; }

json_str() { printf '"%s"' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"; }

load_config() {
	HOST=$(uci -q get "$CONFIG.main.host"); HOST=${HOST:-192.168.100.1}
	USERNAME=$(uci -q get "$CONFIG.main.username"); USERNAME=${USERNAME:-admin}
	PASSWORD=$(uci -q get "$CONFIG.main.password")
	DATA_DIR=$(uci -q get "$CONFIG.main.data_dir"); DATA_DIR=${DATA_DIR:-/etc/modemhealth}
	TIMEOUT=$(uci -q get "$CONFIG.main.timeout"); TIMEOUT=${TIMEOUT:-15}
	ENABLED=$(uci -q get "$CONFIG.main.enabled"); ENABLED=${ENABLED:-1}
	INTERVAL=$(int_or "$(uci -q get "$CONFIG.main.interval")" 5)
	[ "$INTERVAL" -ge 1 ] || INTERVAL=1
	HISTORY_DAYS=$(int_or "$(uci -q get "$CONFIG.main.history_days")" 90)
	[ "$HISTORY_DAYS" -ge 1 ] || HISTORY_DAYS=1
	RUN_DIR=${MODEMHEALTH_RUN_DIR:-/var/run/modemhealth}
	BASE="https://$HOST"
}

# ---------------------------------------------------------------- modem reader
# SURFboard S33/S34: HNAP over JSON, every request signed with HMAC-SHA256.
# Worked out from the modem's own Login.js, hnap.js and SOAPAction.js.

hmac() { # $1=key $2=message -> uppercase hex HMAC-SHA256
	printf '%s' "$2" | openssl dgst -sha256 -hmac "$1" 2>/dev/null | sed 's/^.*= *//' | tr 'abcdef' 'ABCDEF'
}

# The HNAP_AUTH timestamp. The modem's web page sends Date.now() %
# 2000000000000, and the modem answers 403 to any request whose timestamp is
# lower than one it has already accepted (an equal one is fine; checked on a
# real S34). So: real milliseconds from ucode's clock() where available
# (busybox date has none), and never lower than the previous timestamp,
# which is kept in RAM across checks.
now_ms() {
	local ms last
	ms=$(ucode -e 'let c = clock(); print(c[0] * 1000 + int(c[1] / 1000000));' 2>/dev/null)
	case $ms in ''|*[!0-9]*) ms=$(( $(date +%s) * 1000 )) ;; esac
	ms=$(( ms % 2000000000000 ))
	read -r last 2>/dev/null < "$RUN_DIR/last_ms"
	case $last in ''|*[!0-9]*) last=0 ;; esac
	[ "$ms" -gt "$last" ] || ms=$(( last + 1 ))
	echo "$ms" > "$RUN_DIR/last_ms"
	echo "$ms"
}

# hnap ACTION BODY OUTFILE -> sets HTTP_CODE; returns curl's exit code
hnap() {
	local action=$1 body=$2 out=$3 sa ts auth rc
	sa="\"$HNAP_NS$action\""
	ts=$(now_ms)
	auth=$(hmac "${PRIVATE_KEY:-withoutloginkey}" "$ts$sa")
	[ -n "$auth" ] || { HTTP_CODE=000; return 99; }
	if [ -n "$SESSION_UID" ]; then
		set -- -H "Cookie: uid=$SESSION_UID; PrivateKey=$PRIVATE_KEY"
	else
		set --
	fi
	# -k: the modem's certificate is self-signed, and it is only ever this host.
	HTTP_CODE=$(curl -sk --max-time "$TIMEOUT" -o "$out" -w '%{http_code}' \
		-H 'Content-Type: application/json; charset=utf-8' \
		-H 'Accept: application/json' \
		-H "SOAPAction: $sa" \
		-H "HNAP_AUTH: $auth $ts" \
		"$@" \
		--data-binary "$body" "$BASE/HNAP1/")
	rc=$?
	return $rc
}

# Sets FAIL_REASON on failure.
curl_failed() { # $1=curl exit code
	case $1 in
		6|7) FAIL_REASON=unreachable ;;
		28) FAIL_REASON=timeout ;;
		35|60) FAIL_REASON=tls_error ;;
		99) FAIL_REASON=no_openssl ;;
		*) FAIL_REASON="curl_error_$1" ;;
	esac
}

modem_login() {
	local out="$RUN_DIR/login.json" rc challenge public_key cookie result
	PRIVATE_KEY=; SESSION_UID=
	if [ -z "$PASSWORD" ]; then FAIL_REASON=no_password; return 1; fi
	hnap Login "{\"Login\":{\"Action\":\"request\",\"Username\":$(json_str "$USERNAME"),\"LoginPassword\":\"\",\"Captcha\":\"\",\"PrivateLogin\":\"LoginPassword\"}}" "$out"
	rc=$?; [ $rc -eq 0 ] || { curl_failed $rc; return 1; }
	[ "$HTTP_CODE" = 200 ] || { FAIL_REASON="http_$HTTP_CODE"; return 1; }
	challenge=$(jsonfilter -i "$out" -e '@.LoginResponse.Challenge' 2>/dev/null)
	public_key=$(jsonfilter -i "$out" -e '@.LoginResponse.PublicKey' 2>/dev/null)
	cookie=$(jsonfilter -i "$out" -e '@.LoginResponse.Cookie' 2>/dev/null)
	if [ -z "$challenge" ] || [ -z "$public_key" ]; then FAIL_REASON=not_a_supported_modem; return 1; fi

	PRIVATE_KEY=$(hmac "$public_key$PASSWORD" "$challenge")
	SESSION_UID=$cookie
	hnap Login "{\"Login\":{\"Action\":\"login\",\"Username\":$(json_str "$USERNAME"),\"LoginPassword\":\"$(hmac "$PRIVATE_KEY" "$challenge")\",\"Captcha\":\"\",\"PrivateLogin\":\"LoginPassword\"}}" "$out"
	rc=$?; [ $rc -eq 0 ] || { curl_failed $rc; return 1; }
	result=$(jsonfilter -i "$out" -e '@.LoginResponse.LoginResult' 2>/dev/null)
	rm -f "$out"
	case $result in
		OK|OK_CHANGED) return 0 ;;
		FAILED) FAIL_REASON=login_refused ;;
		'') FAIL_REASON=bad_reply ;;
		*) FAIL_REASON="login_$(clean "$result")" ;;
	esac
	PRIVATE_KEY=; SESSION_UID=
	return 1
}

modem_logout() {
	[ -n "$PRIVATE_KEY" ] || return 0
	hnap Logout '{"Logout":{"Action":"logout","Captcha":""}}' /dev/null
	PRIVATE_KEY=; SESSION_UID=
	return 0
}

# One session is kept between checks (in RAM, root only): every login adds
# an entry to the modem's 100-entry event log, so logging in on every check
# would push the line's real events out of it.
session_load() {
	PRIVATE_KEY=; SESSION_UID=
	[ -s "$RUN_DIR/session" ] || return 1
	# Settings changed since the session began: it may be for another
	# modem, user or password.
	if [ /etc/config/$CONFIG -nt "$RUN_DIR/session" ]; then session_drop; return 1; fi
	{ read -r PRIVATE_KEY; read -r SESSION_UID; } < "$RUN_DIR/session"
	[ -n "$PRIVATE_KEY" ] && [ -n "$SESSION_UID" ] && return 0
	session_drop
	return 1
}

session_save() {
	( umask 077; printf '%s\n%s\n' "$PRIVATE_KEY" "$SESSION_UID" > "$RUN_DIR/session" )
}

session_drop() {
	rm -f "$RUN_DIR/session"
	PRIVATE_KEY=; SESSION_UID=
}

# Reads the status with the kept session, logging in (again) only when
# there is none or the modem no longer accepts it.
modem_read_with_session() {
	if session_load; then
		modem_read_status && return 0
		case $FAIL_REASON in
			unreachable|timeout|tls_error|no_openssl|curl_error_*) return 1 ;;
		esac
		log "modem session no longer accepted ($FAIL_REASON); logging in again"
		session_drop
	fi
	FAIL_REASON=
	modem_login || return 1
	session_save
	log "new modem session"
	modem_read_status
}

# Reads all status pages in one request into $RUN_DIR/status.json.
modem_read_status() {
	local body="" a rc out="$RUN_DIR/status.json" result
	for a in $STATUS_ACTIONS; do body="$body${body:+,}\"$a\":\"\""; done
	hnap GetMultipleHNAPs "{\"GetMultipleHNAPs\":{$body}}" "$out"
	rc=$?; [ $rc -eq 0 ] || { curl_failed $rc; return 1; }
	[ "$HTTP_CODE" = 200 ] || { FAIL_REASON="http_$HTTP_CODE"; return 1; }
	result=$(jsonfilter -i "$out" -e '@.GetMultipleHNAPsResponse.GetMultipleHNAPsResult' 2>/dev/null)
	[ "$result" = OK ] || { FAIL_REASON="status_$(clean "${result:-bad_reply}")"; return 1; }
	return 0
}

# field NAME -> value of NAME in the reply to its status action
status_field() { # $1=action $2=field
	jsonfilter -i "$RUN_DIR/status.json" -e "@.GetMultipleHNAPsResponse.$1Response.$2" 2>/dev/null
}

uptime_seconds() { # "0 day(s) 01h:46m:05s" -> 6365
	printf '%s' "$1" | awk '{
		d = 0; h = 0; m = 0; s = 0
		if (match($0, /[0-9]+ *day/)) d = substr($0, RSTART, RLENGTH) + 0
		if (match($0, /[0-9]+h/)) h = substr($0, RSTART, RLENGTH - 1) + 0
		if (match($0, /[0-9]+m/)) m = substr($0, RSTART, RLENGTH - 1) + 0
		if (match($0, /[0-9]+s/)) s = substr($0, RSTART, RLENGTH - 1) + 0
		if ($0 ~ /[0-9]/) print d * 86400 + h * 3600 + m * 60 + s
	}'
}

# channel_rows TS DIR RAW -> CSV lines in CHANNELS_HEADER order
# downstream: index^lock^modulation^id^freq^power^snr^corrected^uncorrectable^
# upstream:   index^lock^type^id^width^freq^power^
channel_rows() {
	printf '%s' "$3" | tr -d '",\\<>' | awk -v ts="$1" -v dir="$2" '{
		n = split($0, rows, /\|\+\|/)
		for (i = 1; i <= n; i++) {
			if (rows[i] == "") continue
			split(rows[i], f, /\^/)
			for (j = 1; j <= 9; j++) gsub(/^ +| +$/, "", f[j])
			if (dir == "ds")
				print ts ",ds," f[1] "," f[2] "," f[3] "," f[4] "," f[5] ",," f[6] "," f[7] "," f[8] "," f[9]
			else
				print ts ",us," f[1] "," f[2] "," f[3] "," f[4] "," f[6] "," f[5] "," f[7] ",,,"
		}
	}'
}

# --------------------------------------------------------------------- storage
#
# DATA_DIR (flash, kept across firmware upgrades):
#   readings/YYYY-MM-DD.csv   one row per check, failed checks included
#   channels/YYYY-MM-DD.csv   one row per channel per good check: power,
#                             SNR/MER, and the corrected and uncorrectable
#                             errors since the previous good check
#   events/YYYY-MM-DD.csv     the modem's event log entries, each stored once,
#                             by the day it was first seen
#   events.seen               the entries of the previous log read
#   channelmap.csv            the channel line-up (modulation, frequency,
#                             width), written only when it changes
#   modem.txt                 model, firmware, MAC: what the ISP needs
#   last                      previous good check: time, uptime, counters
# Days before today are gzipped, and days older than history_days removed.
# 90 days at 5-minute checks with ~40 channels is about 4-8 MB.

today() { date +%Y-%m-%d; }

ensure_store() {
	mkdir -p "$DATA_DIR/readings" "$DATA_DIR/channels" "$DATA_DIR/events" || return 1
	DAY=$(today)
	READINGS="$DATA_DIR/readings/$DAY.csv"
	CHANNELS="$DATA_DIR/channels/$DAY.csv"
	[ -s "$READINGS" ] || echo "$READINGS_HEADER" > "$READINGS"
	[ -s "$CHANNELS" ] || echo "$CHANNELS_HEADER" > "$CHANNELS"
	EVENTS="$DATA_DIR/events/$DAY.csv"
	[ -s "$EVENTS" ] || echo "$EVENTS_HEADER" > "$EVENTS"
	[ -s "$DATA_DIR/channelmap.csv" ] || echo "$CHANNELMAP_HEADER" > "$DATA_DIR/channelmap.csv"
}

store_failed() { # $1=ts $2=reason
	echo "$1,failed,$(clean "$2"),,,,,,,,,,,," >> "$READINGS"
}

# Gzip the days before today, and remove days older than HISTORY_DAYS.
tidy_store() {
	local cutoff f name
	cutoff=$(date -d "@$(( $(date +%s) - HISTORY_DAYS * 86400 ))" +%Y%m%d 2>/dev/null) || return 0
	for f in "$DATA_DIR"/readings/*.csv* "$DATA_DIR"/channels/*.csv* "$DATA_DIR"/events/*.csv*; do
		[ -e "$f" ] || continue
		name=${f##*/}; name=${name%%.*}
		case $name in [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;; *) continue ;; esac
		if [ "$(echo "$name" | tr -d -)" -lt "$cutoff" ]; then
			rm -f "$f"
		elif [ "$name" != "$DAY" ] && [ "${f%.gz}" = "$f" ]; then
			gzip -f "$f"
		fi
	done
}

# Previous good check, from DATA_DIR/last:
#   line 1: "ts uptime"; then "dir,channel_id,corrected,uncorrectable" totals.
read_last() {
	PREV_TS=; PREV_UPTIME=
	[ -s "$DATA_DIR/last" ] || return 1
	read -r PREV_TS PREV_UPTIME < "$DATA_DIR/last"
	PREV_TS=$(int_or "$PREV_TS" ""); PREV_UPTIME=$(int_or "$PREV_UPTIME" "")
	[ -n "$PREV_TS" ] && [ -n "$PREV_UPTIME" ]
}

# Store the channels of a good check. $1=ts $2=reboot(0/1) $3=full rows
# (ts,dir,ch,lock,modulation,channel_id,freq_hz,width_hz,power,snr,corrected,uncorrectable).
# The modem's error counters run since its last restart, so each row stores
# the change since the previous good check: after a restart, or when a
# counter went down, the change is the new count itself; with no earlier
# check for the channel it is left empty (unknown), never guessed.
store_channels() {
	local ts=$1 reboot=$2 rows=$3 map
	printf '%s\n' "$rows" | awk -F, -v reboot="$reboot" -v last="$DATA_DIR/last" -v state="$DATA_DIR/last.new" -v out="$CHANNELS" '
		BEGIN {
			# line 1 of "last" is "ts uptime"; then dir,channel_id,corrected,uncorrectable
			n = 0
			while ((getline line < last) > 0) {
				if (++n == 1) continue
				split(line, p, ",")
				prev[p[1] "," p[2]] = p[3]; prevu[p[1] "," p[2]] = p[4]
			}
			close(last)
		}
		$0 == "" { next }
		{
			k = $2 "," $6; dc = ""; du = ""
			if ($2 == "ds" && $11 != "") {
				if (reboot == 1) { dc = $11; du = $12 }
				else if (k in prev) {
					dc = ($11 + 0 >= prev[k] + 0) ? $11 - prev[k] : $11
					du = ($12 + 0 >= prevu[k] + 0) ? $12 - prevu[k] : $12
				}
				print k "," $11 "," $12 >> state
			}
			print $1 "," $2 "," $6 "," $4 "," $9 "," $10 "," dc "," du >> out
		}'

	# The line-up is stored only when it changes.
	map=$(printf '%s\n' "$rows" | awk -F, 'NF { print $2 "," $3 "," $6 "," $5 "," $7 "," $8 }')
	if [ "$map" != "$(cat "$DATA_DIR/channelmap.last" 2>/dev/null)" ]; then
		printf '%s\n' "$map" | awk -v ts="$ts" 'NF { print ts "," $0 }' >> "$DATA_DIR/channelmap.csv"
		printf '%s\n' "$map" > "$DATA_DIR/channelmap.last"
	fi
}

# The modem's clock minus the router's, in seconds ("" if unknown).
# $1=ts $2=modem time "MM/DD/YYYY HH:MM:SS" (the modem's local time)
clock_offset() {
	local iso m
	iso=$(printf '%s' "$2" | awk '{ split($1, d, "/"); if (d[3] != "") printf "%04d-%02d-%02d %s", d[3], d[1], d[2], $2 }')
	[ -n "$iso" ] || return 0
	m=$(date -d "$iso" +%s 2>/dev/null) || return 0
	echo $(( m - $1 ))
}

# Store the event log entries not seen in the previous read. The modem
# keeps its last 100 entries (newest first) and drops the oldest, so an
# entry is identified by its time and message. Its own web logins are not
# stored (the router's logins would drown out the line's events), and
# neither are IP addresses or the MAC/version suffix of CM-STATUS lines.
# $1=ts $2=log text $3=clock offset
store_events() {
	local ts=$1 offset=$3
	printf '%s' "$2" | tr -d '\000-\037",\\<>' | awk -v ts="$ts" -v offset="$offset" -v seen="$DATA_DIR/events.seen" \
		-v newseen="$DATA_DIR/events.seen.new" -v out="$EVENTS" '
		BEGIN { while ((getline line < seen) > 0) old[line] = 1; close(seen) }
		{
			n = split($0, e, /\}-\{/)
			for (i = n; i >= 1; i--) {   # oldest first
				split(e[i], f, /\^/)
				when = f[2]; level = f[4]; msg = f[5]
				if (when == "" || msg ~ /WebGUI login/) continue
				sub(/;CM-MAC=.*$/, "", msg)
				gsub(/([0-9]+\.){3}[0-9]+/, "x.x.x.x", msg)
				key = when "^" msg
				print key > newseen
				if (key in old) continue
				old[key] = 1
				print ts "," when "," offset "," level "," msg >> out
				added++
			}
		}
		END { printf "%d", added + 0 }'
	mv -f "$DATA_DIR/events.seen.new" "$DATA_DIR/events.seen" 2>/dev/null
}

# ---------------------------------------------------------------------- check

do_check() {
	local ts rows ds us ds_n us_n uptime model firmware reboot=0 boot_ts="" modem_time offset new_events
	load_config
	mkdir -p "$RUN_DIR" && chmod 700 "$RUN_DIR"
	ensure_store || { log "cannot write to $DATA_DIR"; return 1; }
	tidy_store
	ts=$(date +%s)
	FAIL_REASON=

	if ! modem_read_with_session; then
		[ "$FAIL_REASON" = login_refused ] && session_drop
		store_failed "$ts" "$FAIL_REASON"
		rm -f "$RUN_DIR/status.json"
		log "check failed: $FAIL_REASON"
		echo "failed: $FAIL_REASON"
		return 1
	fi

	ds=$(status_field GetCustomerStatusDownstreamChannelInfo CustomerConnDownstreamChannel)
	us=$(status_field GetCustomerStatusUpstreamChannelInfo CustomerConnUpstreamChannel)
	rows=$( { channel_rows "$ts" ds "$ds"; channel_rows "$ts" us "$us"; } )
	ds_n=$(printf '%s\n' "$rows" | grep -c '^[0-9]*,ds,')
	us_n=$(printf '%s\n' "$rows" | grep -c '^[0-9]*,us,')
	uptime=$(uptime_seconds "$(status_field GetCustomerStatusSoftware CustomerConnSystemUpTime)")
	model=$(clean "$(status_field GetCustomerStatusSoftware StatusSoftwareModelName)")
	firmware=$(clean "$(status_field GetCustomerStatusSoftware StatusSoftwareSfVer)")

	# A restart: the modem has been up for less time than has passed since
	# the previous good check (two minutes' grace for clock jitter).
	if [ -n "$uptime" ] && read_last && [ "$ts" -ge "$PREV_TS" ] \
		&& [ $(( uptime + 120 )) -lt $(( PREV_UPTIME + ts - PREV_TS )) ]; then
		reboot=1
		boot_ts=$(( ts - uptime ))
		log "modem restarted at $(date -d "@$boot_ts" '+%Y-%m-%d %H:%M:%S' 2>/dev/null)"
	fi

	modem_time=$(clean "$(status_field GetCustomerStatusConnectionInfo CustomerCurSystemTime)")
	offset=$(clock_offset "$ts" "$modem_time")
	new_events=$(store_events "$ts" "$(status_field GetCustomerStatusLog CustomerStatusLogList)" "$offset")

	echo "$ts ${uptime:-0}" > "$DATA_DIR/last.new"
	[ -n "$rows" ] && store_channels "$ts" "$reboot" "$rows"
	mv -f "$DATA_DIR/last.new" "$DATA_DIR/last"
	echo "$ts,ok,,$model,$firmware,$uptime,$(clean "$(status_field GetCustomerStatusStartupSequence CustomerConnConnectivityComment)"),$(clean "$(status_field GetCustomerStatusStartupSequence CustomerConnBootComment)"),$(clean "$(status_field GetCustomerStatusConnectionInfo CustomerConnNetworkAccess)"),$modem_time,$ds_n,$us_n,$reboot,$boot_ts,$offset" >> "$READINGS"

	# What identifies the modem to the ISP; overwritten on every good reading.
	{
		echo "model=$model"
		echo "firmware=$firmware"
		echo "mac=$(clean "$(status_field GetCustomerStatusSoftware StatusSoftwareMac)")"
		echo "docsis=$(clean "$(status_field GetCustomerStatusSoftware StatusSoftwareCustomerVer)")"
	} > "$DATA_DIR/modem.txt.new" && mv -f "$DATA_DIR/modem.txt.new" "$DATA_DIR/modem.txt"

	rm -f "$RUN_DIR/status.json"
	echo "ok: $model, $ds_n downstream and $us_n upstream channels, up ${uptime}s, ${new_events:-0} new events$([ $reboot = 1 ] && echo ', restarted since the last check')"
}

do_logout() {
	load_config
	mkdir -p "$RUN_DIR" && chmod 700 "$RUN_DIR"
	session_load && modem_logout
	session_drop
}

# All stored readings, oldest first, without headers.
all_readings() {
	local f
	for f in "$DATA_DIR"/readings/*.csv.gz "$DATA_DIR"/readings/*.csv; do
		[ -e "$f" ] || continue
		case $f in *.gz) gzip -dc "$f" ;; *) cat "$f" ;; esac | tail -n +2
	done
}

do_last() {
	load_config
	local r
	r=$(all_readings | tail -n 1)
	[ -n "$r" ] || { echo "no readings yet"; return 1; }
	echo "$r"
}

do_history() {
	load_config
	all_readings | tail -n "$(int_or "$1" 12)" | awk -F, '{
		cmd = "date -d @" $1 " \"+%Y-%m-%d %H:%M:%S\""; cmd | getline when; close(cmd)
		if ($2 == "ok")
			printf "%s  ok      up %dd %02dh%02dm  %s ds / %s us%s\n", when, $6 / 86400, ($6 % 86400) / 3600, ($6 % 3600) / 60, $11, $12, ($13 == 1 ? "  RESTARTED" : "")
		else
			printf "%s  FAILED  %s\n", when, $3
	}'
}

# --------------------------------------------------------------------- daemon

uptime_s() { local u; read -r u _ < /proc/uptime; echo "${u%.*}"; }

# Interruptible sleep (lets the TERM trap run straight away).
nap() { sleep "$1" & SLEEP_PID=$!; wait "$SLEEP_PID"; }

# The router has no battery-backed clock: until NTP has set the time a
# reading would carry the wrong date, which is worthless as evidence. The
# ntp hotplug (shipped with dnsmasq) leaves a flag once the time is valid;
# without that flag, give NTP ten minutes.
time_synced() {
	[ -e /var/state/dnsmasqsec ] && return 0
	[ "$(uptime_s)" -ge 600 ]
}

# Up to 20 seconds, so checks don't always land on the same second.
jitter() { awk 'BEGIN { srand(); print int(rand() * 20) }'; }

do_daemon() {
	local base="" up due last t
	SLEEP_PID=""; CHECK_PID=""
	trap 'kill $SLEEP_PID $CHECK_PID 2>/dev/null; do_logout >/dev/null 2>&1; rm -f "$RUN_DIR/next"; exit 0' INT TERM
	load_config
	mkdir -p "$RUN_DIR" && chmod 700 "$RUN_DIR"
	# Settings are re-read every minute, so changes apply even when procd's
	# config trigger does not restart us.
	while :; do
		load_config
		if [ "$ENABLED" != 1 ] || ! time_synced; then
			rm -f "$RUN_DIR/next"
			base=""
			nap 60
			continue
		fi
		# The schedule runs on the router's uptime, so clock steps (NTP
		# after boot) can neither stall it nor cause a burst of checks.
		up=$(uptime_s)
		t=$(date +%s)
		if [ -z "$base" ]; then
			# (Re)start: carry on from the last reading if it is recent,
			# otherwise check now.
			last=$(do_last 2>/dev/null | cut -d, -f1)
			last=$(int_or "$last" 0)
			if [ "$last" -gt 0 ] && [ "$last" -le "$t" ] && [ $(( t - last )) -lt $(( INTERVAL * 60 )) ]; then
				base=$(( up - (t - last) ))
			else
				base=$(( up - INTERVAL * 60 ))
			fi
		fi
		due=$(( base + INTERVAL * 60 ))
		if [ "$up" -lt "$due" ]; then
			echo $(( t + due - up )) > "$RUN_DIR/next"
			nap $(( due - up > 60 ? 60 : due - up ))
			continue
		fi
		base=$(( up + $(jitter) ))
		( do_check ) >/dev/null 2>&1 &
		CHECK_PID=$!
		wait "$CHECK_PID"
		CHECK_PID=""
	done
}

# MODEMHEALTH_LIB=1: only define the functions (for probes and tests).
[ "${MODEMHEALTH_LIB:-}" = 1 ] && return 0 2>/dev/null

case "$1" in
	check) do_check ;;
	history) do_history "$2" ;;
	last) do_last ;;
	logout) do_logout ;;
	daemon) do_daemon ;;
	*)
		echo "usage: modemhealth check|history [N]|last|logout|daemon" >&2
		exit 2
		;;
esac
