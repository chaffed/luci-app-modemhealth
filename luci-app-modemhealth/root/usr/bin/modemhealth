#!/bin/sh
# Modem Health: read a cable modem's status and keep it as evidence.
#
#   modemhealth check        read the modem once and store the reading
#   modemhealth history [N]  print the last N readings (default 12)
#   modemhealth last         print the latest stored reading
#   modemhealth logout       end the modem session kept between checks
#   modemhealth daemon       check on schedule (started by /etc/init.d/modemhealth)
#   modemhealth status       state, last reading and modem identity, as JSON
#   modemhealth data SINCE [UNTIL]
#                            stored readings, channels, events and line-up
#                            between two times (epoch seconds), as JSON; with
#                            ISPy's speed tests of that time, if it has any
#   modemhealth test         try logging in with MH_HOST, MH_USER and
#                            MH_PASSWORD (environment; empty = saved), as JSON
#   modemhealth set-password read a new modem password from stdin and save it
#   modemhealth restart [TRIGGER [DETAIL]]
#                            restart the modem (TRIGGER: manual, down or
#                            signal) and record it, as JSON
#
# The password is kept in /etc/config/modemhealth_auth (root only), apart
# from the other settings, so that the web pages, which load the whole
# settings file, never receive it.
#
# Supported modems: ARRIS/Vantiva SURFboard S33 and S34 (HNAP, HMAC-SHA256),
# and T-Mobile 5G Home Internet gateways that speak the TMI API (Arcadyan
# KVD21, Sagemcom 5688W, TMO-G4AR/G4SE/G5AR/G5SE; built from public clients'
# code, not yet tested on a real one: #28). The readers (the "modem_*" and
# "gw_*" functions) only fetch and turn replies into lines; storage is
# separate. Setting modem_type: auto (default), surfboard or tmobile.
#
# SPDX-License-Identifier: MIT
# shellcheck shell=dash

CONFIG=modemhealth
SHARE=${MODEMHEALTH_SHARE:-/usr/share/modemhealth}
WWW=${MODEMHEALTH_WWW:-/www/luci-static/resources/modemhealth}
# The report file on a drive carries this many days of history.
REPORT_DAYS=30
VERSION=1.1.0   # the package's PKG_VERSION (tests/settings.test.js checks)
HNAP_NS='http://purenetworks.com/HNAP1/'
STATUS_ACTIONS='GetCustomerStatusStartupSequence GetCustomerStatusConnectionInfo GetCustomerStatusDownstreamChannelInfo GetCustomerStatusUpstreamChannelInfo GetCustomerStatusSoftware GetCustomerStatusLog'
# Stored per day, in DATA_DIR/readings/ and DATA_DIR/channels/ (see storage).
READINGS_HEADER='ts,result,reason,model,firmware,uptime_s,connectivity,boot,network_access,modem_time,ds_channels,us_channels,reboot,boot_ts,clock_offset_s,modem_ping_loss,modem_ping_ms,inet_ping_loss,inet_ping_ms'
EVENTS_HEADER='first_seen_ts,modem_time,clock_offset_s,level,message'
CHANNELS_HEADER='ts,dir,channel_id,lock,power_dbmv,snr_db,corrected,uncorrectable'
CHANNELMAP_HEADER='ts,dir,ch,channel_id,modulation,freq_hz,width_hz'
# A gateway's radios, one row per radio per good check (tech: lte or nr).
RADIOS_HEADER='ts,tech,bands,bars,rsrp_dbm,rsrq_db,rssi_dbm,sinr_db,cell'
# Every restart Modem Health made or tried (see "restart").
RESTARTS_HEADER='ts,trigger,result,detail,fail_reason'

log() { logger -t modemhealth "$*" 2>/dev/null; [ -t 2 ] && echo "modemhealth: $*" >&2; return 0; }

# Text from the modem goes into CSV files and, later, web pages: keep it to
# printable characters without the CSV and HTML specials.
clean() { printf '%s' "$*" | tr -d '\000-\037",\\<>' | cut -c1-120; }

int_or() { case "$1" in ''|*[!0-9]*) echo "$2" ;; *) echo "$1" ;; esac; }

json_str() { printf '"%s"' "$(printf '%s' "$1" | tr -d '\000-\037' | sed 's/\\/\\\\/g; s/"/\\"/g')"; }
json_num() { case "$1" in ''|*[!0-9.-]*) printf null ;; *) printf '%s' "$1" ;; esac; }
json_bool() { if "$@"; then printf true; else printf false; fi; }

load_config() {
	HOST=$(uci -q get "$CONFIG.main.host"); HOST=${HOST:-192.168.100.1}
	USERNAME=$(uci -q get "$CONFIG.main.username"); USERNAME=${USERNAME:-admin}
	PASSWORD=$(uci -q get "$CONFIG"_auth.main.password)
	# Before 0.1.0-r2 the password was kept with the other settings.
	[ -n "$PASSWORD" ] || PASSWORD=$(uci -q get "$CONFIG.main.password")
	DATA_DIR=$(uci -q get "$CONFIG.main.data_dir"); DATA_DIR=${DATA_DIR:-/etc/modemhealth}
	TIMEOUT=$(uci -q get "$CONFIG.main.timeout"); TIMEOUT=${TIMEOUT:-15}
	ENABLED=$(uci -q get "$CONFIG.main.enabled"); ENABLED=${ENABLED:-1}
	INTERVAL=$(int_or "$(uci -q get "$CONFIG.main.interval")" 5)
	[ "$INTERVAL" -ge 1 ] || INTERVAL=1
	PING_HOST=$(uci -q get "$CONFIG.main.ping_host"); PING_HOST=${PING_HOST:-1.1.1.1}
	HISTORY_DAYS=$(int_or "$(uci -q get "$CONFIG.main.history_days")" 90)
	[ "$HISTORY_DAYS" -ge 1 ] || HISTORY_DAYS=1
	RUN_DIR=${MODEMHEALTH_RUN_DIR:-/var/run/modemhealth}
	EXPORT_DIR=$(uci -q get "$CONFIG.main.export_dir")
	MODEM_TYPE=$(uci -q get "$CONFIG.main.modem_type")
	case $MODEM_TYPE in surfboard|tmobile) ;; *) MODEM_TYPE=auto ;; esac
	BASE="https://$HOST"
}

# ---------------------------------------------------------------- modem reader
# SURFboard S33/S34: HNAP over JSON, every request signed with HMAC-SHA256.
# Worked out from the modem's own Login.js, hnap.js and SOAPAction.js.

hmac() { # $1=key $2=message -> uppercase hex HMAC-SHA256
	printf '%s' "$2" | openssl dgst -sha256 -hmac "$1" 2>/dev/null | sed 's/^.*= *//' | tr 'abcdef' 'ABCDEF'
}

# The HNAP_AUTH timestamp. The modem's web page sends Date.now() %
# 2000000000000, and the modem answers 403 to any request whose timestamp is
# lower than one it has already accepted (an equal one is fine; checked on a
# real S34). So: real milliseconds from ucode's clock() where available
# (busybox date has none), and never lower than the previous timestamp,
# which is kept in RAM across checks.
now_ms() {
	local ms last
	ms=$(ucode -e 'let c = clock(); print(c[0] * 1000 + int(c[1] / 1000000));' 2>/dev/null)
	case $ms in ''|*[!0-9]*) ms=$(( $(date +%s) * 1000 )) ;; esac
	ms=$(( ms % 2000000000000 ))
	read -r last 2>/dev/null < "$RUN_DIR/last_ms"
	case $last in ''|*[!0-9]*) last=0 ;; esac
	[ "$ms" -gt "$last" ] || ms=$(( last + 1 ))
	echo "$ms" > "$RUN_DIR/last_ms"
	echo "$ms"
}

# hnap ACTION BODY OUTFILE -> sets HTTP_CODE; returns curl's exit code
hnap() {
	local action=$1 body=$2 out=$3 sa ts auth rc
	sa="\"$HNAP_NS$action\""
	ts=$(now_ms)
	auth=$(hmac "${PRIVATE_KEY:-withoutloginkey}" "$ts$sa")
	[ -n "$auth" ] || { HTTP_CODE=000; return 99; }
	if [ -n "$SESSION_UID" ]; then
		set -- -H "Cookie: uid=$SESSION_UID; PrivateKey=$PRIVATE_KEY"
	else
		set --
	fi
	# -k: the modem's certificate is self-signed, and it is only ever this host.
	HTTP_CODE=$(curl -sk --max-time "$TIMEOUT" -o "$out" -w '%{http_code}' \
		-H 'Content-Type: application/json; charset=utf-8' \
		-H 'Accept: application/json' \
		-H "SOAPAction: $sa" \
		-H "HNAP_AUTH: $auth $ts" \
		"$@" \
		--data-binary "$body" "$BASE/HNAP1/")
	rc=$?
	return $rc
}

# Sets FAIL_REASON on failure.
curl_failed() { # $1=curl exit code
	case $1 in
		6|7) FAIL_REASON=unreachable ;;
		28) FAIL_REASON=timeout ;;
		35|60) FAIL_REASON=tls_error ;;
		99) FAIL_REASON=no_openssl ;;
		*) FAIL_REASON="curl_error_$1" ;;
	esac
}

modem_login() {
	local out="$RUN_DIR/login.json" rc challenge public_key cookie result
	PRIVATE_KEY=; SESSION_UID=
	if [ -z "$PASSWORD" ]; then FAIL_REASON=no_password; return 1; fi
	hnap Login "{\"Login\":{\"Action\":\"request\",\"Username\":$(json_str "$USERNAME"),\"LoginPassword\":\"\",\"Captcha\":\"\",\"PrivateLogin\":\"LoginPassword\"}}" "$out"
	rc=$?; [ $rc -eq 0 ] || { curl_failed $rc; return 1; }
	[ "$HTTP_CODE" = 200 ] || { FAIL_REASON="http_$HTTP_CODE"; return 1; }
	challenge=$(jsonfilter -i "$out" -e '@.LoginResponse.Challenge' 2>/dev/null)
	public_key=$(jsonfilter -i "$out" -e '@.LoginResponse.PublicKey' 2>/dev/null)
	cookie=$(jsonfilter -i "$out" -e '@.LoginResponse.Cookie' 2>/dev/null)
	if [ -z "$challenge" ] || [ -z "$public_key" ]; then FAIL_REASON=not_a_supported_modem; return 1; fi

	PRIVATE_KEY=$(hmac "$public_key$PASSWORD" "$challenge")
	SESSION_UID=$cookie
	hnap Login "{\"Login\":{\"Action\":\"login\",\"Username\":$(json_str "$USERNAME"),\"LoginPassword\":\"$(hmac "$PRIVATE_KEY" "$challenge")\",\"Captcha\":\"\",\"PrivateLogin\":\"LoginPassword\"}}" "$out"
	rc=$?; [ $rc -eq 0 ] || { curl_failed $rc; return 1; }
	result=$(jsonfilter -i "$out" -e '@.LoginResponse.LoginResult' 2>/dev/null)
	rm -f "$out"
	case $result in
		OK|OK_CHANGED) return 0 ;;
		FAILED) FAIL_REASON=login_refused ;;
		'') FAIL_REASON=bad_reply ;;
		*) FAIL_REASON="login_$(clean "$result")" ;;
	esac
	PRIVATE_KEY=; SESSION_UID=
	return 1
}

modem_logout() {
	[ -n "$PRIVATE_KEY" ] || return 0
	hnap Logout '{"Logout":{"Action":"logout","Captcha":""}}' /dev/null
	PRIVATE_KEY=; SESSION_UID=
	return 0
}

# One session is kept between checks (in RAM, root only): every login adds
# an entry to the modem's 100-entry event log, so logging in on every check
# would push the line's real events out of it.
session_load() {
	PRIVATE_KEY=; SESSION_UID=
	[ -s "$RUN_DIR/session" ] || return 1
	# Settings changed since the session began: it may be for another
	# modem, user or password.
	if [ /etc/config/$CONFIG -nt "$RUN_DIR/session" ] || [ /etc/config/${CONFIG}_auth -nt "$RUN_DIR/session" ]; then
		session_drop
		return 1
	fi
	{ read -r PRIVATE_KEY; read -r SESSION_UID; } < "$RUN_DIR/session"
	[ -n "$PRIVATE_KEY" ] && [ -n "$SESSION_UID" ] && return 0
	session_drop
	return 1
}

session_save() {
	( umask 077; printf '%s\n%s\n' "$PRIVATE_KEY" "$SESSION_UID" > "$RUN_DIR/session" )
}

session_drop() {
	rm -f "$RUN_DIR/session"
	PRIVATE_KEY=; SESSION_UID=
}

# Runs FUNCTION with the kept session, logging in (again) only when there
# is none or the modem no longer accepts it.
modem_with_session() { # $1=function
	if session_load; then
		"$1" && return 0
		case $FAIL_REASON in
			unreachable|timeout|tls_error|no_openssl|curl_error_*|restart_*) return 1 ;;
		esac
		log "modem session no longer accepted ($FAIL_REASON); logging in again"
		session_drop
	fi
	FAIL_REASON=
	modem_login || return 1
	session_save
	log "new modem session"
	"$1"
}

modem_read_with_session() { modem_with_session modem_read_status; }

# Restarts a SURFboard, as the Restart button on its Configuration page
# does (the modem's configuration.js): read the current settings, then
# send SetArrisConfigurationInfo with Action "reboot" and the Energy
# Efficient Ethernet and LED settings just read, which the modem's page
# always sends back with it (other values would change them). The same
# call with Action "restore" is a factory reset: the action here is fixed.
# Sets FAIL_REASON on failure; restart_* reasons mean the reboot itself was
# refused (not worth a new login).
modem_restart() {
	local out="$RUN_DIR/restart.json" rc result eee led action
	hnap GetMultipleHNAPs '{"GetMultipleHNAPs":{"GetArrisConfigurationInfo":"","GetCustomerStatusSoftware":""}}' "$out"
	rc=$?; [ $rc -eq 0 ] || { curl_failed $rc; rm -f "$out"; return 1; }
	[ "$HTTP_CODE" = 200 ] || { FAIL_REASON="http_$HTTP_CODE"; rm -f "$out"; return 1; }
	result=$(jsonfilter -i "$out" -e '@.GetMultipleHNAPsResponse.GetArrisConfigurationInfoResponse.GetArrisConfigurationInfoResult' 2>/dev/null)
	eee=$(jsonfilter -i "$out" -e '@.GetMultipleHNAPsResponse.GetArrisConfigurationInfoResponse.ethSWEthEEE' 2>/dev/null)
	led=$(jsonfilter -i "$out" -e '@.GetMultipleHNAPsResponse.GetArrisConfigurationInfoResponse.LedStatus' 2>/dev/null)
	rm -f "$out"
	[ "$result" = OK ] || { FAIL_REASON="status_$(clean "${result:-bad_reply}")"; return 1; }
	# Settings the modem's page would send back unchanged; anything else
	# is not a reply this was written for, and nothing is sent.
	case $eee in [0-9]) ;; *) FAIL_REASON=restart_unknown_settings; return 1 ;; esac
	case $led in [0-9]) ;; *) FAIL_REASON=restart_unknown_settings; return 1 ;; esac
	hnap SetArrisConfigurationInfo "{\"SetArrisConfigurationInfo\":{\"Action\":\"reboot\",\"SetEEEEnable\":\"$eee\",\"LED_Status\":\"$led\"}}" "$out"
	rc=$?; [ $rc -eq 0 ] || { curl_failed $rc; rm -f "$out"; return 1; }
	[ "$HTTP_CODE" = 200 ] || { FAIL_REASON="http_$HTTP_CODE"; rm -f "$out"; return 1; }
	result=$(jsonfilter -i "$out" -e '@.SetArrisConfigurationInfoResponse.SetArrisConfigurationInfoResult' 2>/dev/null)
	action=$(jsonfilter -i "$out" -e '@.SetArrisConfigurationInfoResponse.SetArrisConfigurationInfoAction' 2>/dev/null)
	rm -f "$out"
	[ "$result" = OK ] && [ "$action" = REBOOT ] && return 0
	FAIL_REASON="restart_$(clean "${result:-bad_reply}")"
	return 1
}

# Reads all status pages in one request into $RUN_DIR/status.json.
modem_read_status() {
	local body="" a rc out="$RUN_DIR/status.json" result
	for a in $STATUS_ACTIONS; do body="$body${body:+,}\"$a\":\"\""; done
	hnap GetMultipleHNAPs "{\"GetMultipleHNAPs\":{$body}}" "$out"
	rc=$?; [ $rc -eq 0 ] || { curl_failed $rc; return 1; }
	[ "$HTTP_CODE" = 200 ] || { FAIL_REASON="http_$HTTP_CODE"; return 1; }
	result=$(jsonfilter -i "$out" -e '@.GetMultipleHNAPsResponse.GetMultipleHNAPsResult' 2>/dev/null)
	[ "$result" = OK ] || { FAIL_REASON="status_$(clean "${result:-bad_reply}")"; return 1; }
	return 0
}

# field NAME -> value of NAME in the reply to its status action
status_field() { # $1=action $2=field
	jsonfilter -i "$RUN_DIR/status.json" -e "@.GetMultipleHNAPsResponse.$1Response.$2" 2>/dev/null
}

uptime_seconds() { # "0 day(s) 01h:46m:05s" -> 6365
	printf '%s' "$1" | awk '{
		d = 0; h = 0; m = 0; s = 0
		if (match($0, /[0-9]+ *day/)) d = substr($0, RSTART, RLENGTH) + 0
		if (match($0, /[0-9]+h/)) h = substr($0, RSTART, RLENGTH - 1) + 0
		if (match($0, /[0-9]+m/)) m = substr($0, RSTART, RLENGTH - 1) + 0
		if (match($0, /[0-9]+s/)) s = substr($0, RSTART, RLENGTH - 1) + 0
		if ($0 ~ /[0-9]/) print d * 86400 + h * 3600 + m * 60 + s
	}'
}

# channel_rows TS DIR RAW -> CSV lines in CHANNELS_HEADER order
# downstream: index^lock^modulation^id^freq^power^snr^corrected^uncorrectable^
# upstream:   index^lock^type^id^width^freq^power^
channel_rows() {
	printf '%s' "$3" | tr -d '",\\<>' | awk -v ts="$1" -v dir="$2" '{
		n = split($0, rows, /\|\+\|/)
		for (i = 1; i <= n; i++) {
			if (rows[i] == "") continue
			split(rows[i], f, /\^/)
			for (j = 1; j <= 9; j++) gsub(/^ +| +$/, "", f[j])
			if (dir == "ds")
				print ts ",ds," f[1] "," f[2] "," f[3] "," f[4] "," f[5] ",," f[6] "," f[7] "," f[8] "," f[9]
			else
				print ts ",us," f[1] "," f[2] "," f[3] "," f[4] "," f[6] "," f[5] "," f[7] ",,,"
		}
	}'
}

# -------------------------------------------------------------- gateway reader
# T-Mobile 5G Home Internet gateways (TMI REST API). GET
# /TMI/v1/gateway?get=all answers without a login with the device, both
# radios (signal.4g / signal.5g, either missing or null) and the uptime (no
# "time" on a G5AR). The API answers on port 8080 or 80 depending on the
# model. Nothing else is ever requested: no login (failed logins lock the
# gateway's admin account), and never anything that writes.

# Ports to try: the one in the address if it has one, else 8080 then 80.
gw_ports() {
	case $HOST in
		*:*) echo "${HOST##*:}" ;;
		*) echo "${MODEMHEALTH_GW_PORTS:-8080 80}" ;;   # (the tests use other ports)
	esac
}

# gw_get PORT -> $RUN_DIR/gateway.json; sets HTTP_CODE; returns curl's code
gw_get() {
	HTTP_CODE=$(curl -s --max-time "$TIMEOUT" -o "$RUN_DIR/gateway.json" -w '%{http_code}' \
		-H 'Accept: application/json' "http://${HOST%%:*}:$1/TMI/v1/gateway?get=all")
}

gw_field() { # $1=jsonfilter path below the reply
	jsonfilter -i "$RUN_DIR/gateway.json" -e "@$1" 2>/dev/null | head -n 1
}

# A reply is a gateway's when it has the signal block.
gw_is_reply() {
	jsonfilter -i "$RUN_DIR/gateway.json" -e '@.signal' >/dev/null 2>&1
}

# Reads the gateway into $RUN_DIR/gateway.json; sets GW_PORT, or
# FAIL_REASON. The port that answered is remembered (in RAM).
gw_read() {
	local p rc ports cached=""
	[ -s "$RUN_DIR/gateway.port" ] && [ "$RUN_DIR/gateway.port" -nt /etc/config/$CONFIG ] && cached=$(cat "$RUN_DIR/gateway.port")
	ports=$cached
	for p in $(gw_ports); do [ "$p" = "$cached" ] || ports="$ports $p"; done
	FAIL_REASON=
	for p in $ports; do
		gw_get "$p"; rc=$?
		# The most telling reason wins: something that answered (a wrong
		# page, not a gateway) over a port where nothing did.
		if [ $rc -ne 0 ]; then
			case $FAIL_REASON in http_*|not_a_supported_device) ;; *) curl_failed $rc ;; esac
			continue
		fi
		if [ "$HTTP_CODE" != 200 ]; then FAIL_REASON="http_$HTTP_CODE"; continue; fi
		if ! gw_is_reply; then FAIL_REASON=not_a_supported_device; continue; fi
		GW_PORT=$p
		echo "$p" > "$RUN_DIR/gateway.port"
		return 0
	done
	rm -f "$RUN_DIR/gateway.json"
	return 1
}

# A number within [lo, hi], else empty: a value outside the range the
# 3GPP specifications allow a device to report is a bad reading, not a
# bad signal. Whole numbers without ".0".
in_range() { # $1=value $2=lo $3=hi
	printf '%s' "$1" | awk -v lo="$2" -v hi="$3" '
		/^-?[0-9]+(\.[0-9]+)?$/ { v = $0 + 0; if (v >= lo && v <= hi) { if (v == int(v)) printf "%d", v; else printf "%s", v } }'
}

# gw_radio_rows TS -> CSV lines in RADIOS_HEADER order, LTE then NR.
# Ranges: 3GPP TS 36.133 (LTE) and 38.133 (NR) reporting ranges, the wider
# of the two: RSRP -156..-31 dBm, RSRQ -43..20 dB, SINR -23..40 dB; RSSI
# has no reporting range in either, so -120..0 dBm is used as a sanity
# bound only.
gw_radio_rows() {
	local key tech id bands cell
	for key in 4g 5g; do
		jsonfilter -i "$RUN_DIR/gateway.json" -e "@.signal[\"$key\"].rsrp" >/dev/null 2>&1 ||
			jsonfilter -i "$RUN_DIR/gateway.json" -e "@.signal[\"$key\"].bands" >/dev/null 2>&1 || continue
		if [ "$key" = 4g ]; then tech=lte; id=eNBID; else tech=nr; id=gNBID; fi
		bands=$(jsonfilter -i "$RUN_DIR/gateway.json" -e "@.signal[\"$key\"].bands[*]" 2>/dev/null | tr '\n' ' ' | tr -d '\000-\037",\\<>' | sed 's/  */ /g; s/^ //; s/ $//' | cut -c1-60)
		cell=$(int_or "$(gw_field ".signal[\"$key\"].$id")" "")
		[ -n "$cell" ] && cell="$cell-$(int_or "$(gw_field ".signal[\"$key\"].cid")" "")"
		printf '%s,%s,%s,%s,%s,%s,%s,%s,%s\n' "$1" "$tech" "$bands" \
			"$(in_range "$(gw_field ".signal[\"$key\"].bars")" 0 5)" \
			"$(in_range "$(gw_field ".signal[\"$key\"].rsrp")" -156 -31)" \
			"$(in_range "$(gw_field ".signal[\"$key\"].rsrq")" -43 20)" \
			"$(in_range "$(gw_field ".signal[\"$key\"].rssi")" -120 0)" \
			"$(in_range "$(gw_field ".signal[\"$key\"].sinr")" -23 40)" "$cell"
	done
}

# Restarts a T-Mobile gateway: log in once (POST auth/login, the admin
# password) and POST gateway/reset?set=reboot with the token, as the public
# clients do (#39). Untested on a real gateway, so it runs only with the
# hidden setting gw_restart=1 (for a beta tester). Repeated failed logins
# lock the gateway's admin page, so a refused password is never tried
# again until the password is changed in Settings. The password and token
# go to curl on its input, never as arguments (which every process can
# read). Sets FAIL_REASON on failure.
gw_restart() {
	local out="$RUN_DIR/gw-restart.json" refused="$DATA_DIR/gw_login_refused" base token rc
	[ "$(uci -q get "$CONFIG.main.gw_restart")" = 1 ] || { FAIL_REASON=restart_not_enabled; return 1; }
	[ -n "$PASSWORD" ] || { FAIL_REASON=no_password; return 1; }
	if [ -e "$refused" ] && ! [ /etc/config/${CONFIG}_auth -nt "$refused" ]; then
		FAIL_REASON=restart_password_refused_before; return 1
	fi
	[ -n "$GW_PORT" ] || gw_read || return 1
	base="http://${HOST%%:*}:$GW_PORT/TMI/v1"
	HTTP_CODE=$(printf '{"username":%s,"password":%s}' "$(json_str "$USERNAME")" "$(json_str "$PASSWORD")" |
		curl -s --max-time "$TIMEOUT" -o "$out" -w '%{http_code}' -H 'Content-Type: application/json' \
			--data-binary @- "$base/auth/login")
	rc=$?; [ $rc -eq 0 ] || { curl_failed $rc; rm -f "$out"; return 1; }
	case $HTTP_CODE in
		200) ;;
		401|403) : > "$refused"; FAIL_REASON=login_refused; rm -f "$out"; return 1 ;;
		*) FAIL_REASON="http_$HTTP_CODE"; rm -f "$out"; return 1 ;;
	esac
	rm -f "$refused"
	token=$(jsonfilter -i "$out" -e '@.auth.token' 2>/dev/null)
	rm -f "$out"
	case $token in ''|*[!A-Za-z0-9._-]*) FAIL_REASON=bad_reply; return 1 ;; esac
	HTTP_CODE=$(printf 'header = "Authorization: Bearer %s"\n' "$token" |
		curl -s --max-time "$TIMEOUT" -o /dev/null -w '%{http_code}' -K - -X POST "$base/gateway/reset?set=reboot")
	rc=$?; [ $rc -eq 0 ] || { curl_failed $rc; return 1; }
	case $HTTP_CODE in 2??) return 0 ;; esac
	FAIL_REASON="restart_http_$HTTP_CODE"
	return 1
}

# Which reader to use: sets DEVICE to surfboard or tmobile. "auto": a
# SURFboard at its usual address; elsewhere the gateway API if it answers.
detect_device() {
	DEVICE=$MODEM_TYPE
	[ "$DEVICE" = auto ] || return 0
	case ${HOST%%:*} in 192.168.100.1) DEVICE=surfboard; return 0 ;; esac
	if [ -s "$RUN_DIR/device" ] && [ "$RUN_DIR/device" -nt /etc/config/$CONFIG ]; then
		DEVICE=$(cat "$RUN_DIR/device")
		case $DEVICE in surfboard|tmobile) return 0 ;; esac
	fi
	# Only what answered is remembered: a gateway that is down for a
	# moment must not be taken for a SURFboard until the next restart.
	if gw_read; then
		DEVICE=tmobile
		echo tmobile > "$RUN_DIR/device"
	else
		DEVICE=surfboard
	fi
}

# --------------------------------------------------------------------- storage
#
# DATA_DIR (flash, kept across firmware upgrades):
#   readings/YYYY-MM-DD.csv   one row per check, failed checks included
#   channels/YYYY-MM-DD.csv   one row per channel per good check: power,
#                             SNR/MER, and the corrected and uncorrectable
#                             errors since the previous good check
#   events/YYYY-MM-DD.csv     the modem's event log entries, each stored once,
#                             by the day it was first seen
#   events.seen               the entries of the previous log read
#   radios/YYYY-MM-DD.csv     a gateway's radios, one row per radio per good
#                             check: band, bars, RSRP, RSRQ, RSSI, SINR and
#                             the tower (eNB/gNB ID and cell ID)
#   radios.last               the radios at the previous good check, to
#                             notice tower and band changes
#   channelmap.csv            the channel line-up (position, modulation,
#                             frequency, width): an entry for a channel
#                             only when one of these changes
#   channelmap.last           the line-up at the previous good check
#   modem.txt                 type, model, firmware, MAC: what the ISP needs
#   restarts.csv              every restart Modem Health made or tried
#   gw_login_refused          the gateway refused the password at a restart:
#                             no restart logs in again until it is changed
#   last                      previous good check: time, uptime, counters
# Days before today are gzipped, and days older than history_days removed.
# 90 days at 5-minute checks with ~40 channels is about 4-8 MB.

today() { date +%Y-%m-%d; }

ensure_store() {
	mkdir -p "$DATA_DIR/readings" "$DATA_DIR/channels" "$DATA_DIR/events" || return 1
	DAY=$(today)
	READINGS="$DATA_DIR/readings/$DAY.csv"
	CHANNELS="$DATA_DIR/channels/$DAY.csv"
	[ -s "$READINGS" ] || echo "$READINGS_HEADER" > "$READINGS"
	[ -s "$CHANNELS" ] || echo "$CHANNELS_HEADER" > "$CHANNELS"
	EVENTS="$DATA_DIR/events/$DAY.csv"
	[ -s "$EVENTS" ] || echo "$EVENTS_HEADER" > "$EVENTS"
	[ -s "$DATA_DIR/channelmap.csv" ] || echo "$CHANNELMAP_HEADER" > "$DATA_DIR/channelmap.csv"
}

store_failed() { # $1=ts $2=reason
	echo "$1,failed,$(clean "$2"),,,,,,,,,,,,,$PINGS" >> "$READINGS"
}

# ping_stats HOST -> "loss_percent,average_ms" (3 pings; "100," if none came back)
ping_stats() {
	ping -c 3 -W 2 -q "$1" 2>/dev/null | awk '
		/packet loss/ { for (i = 1; i <= NF; i++) if ($i ~ /%$/) { loss = $i; sub(/%/, "", loss) } }
		/min\/avg\/max/ { split($0, a, "= "); split(a[2], v, "/"); avg = v[2] }
		END { printf "%s,%s", (loss == "" ? 100 : loss), avg }'
}

# Pings the modem and an internet host at the same time; sets PINGS to
# "modem_loss,modem_ms,inet_loss,inet_ms". Done on every check, failed
# readings included: with the modem unreachable and the internet down,
# these are what show an outage.
measure_pings() {
	local host=${HOST%%:*}
	ping_stats "$host" > "$RUN_DIR/ping.modem" &
	ping_stats "$PING_HOST" > "$RUN_DIR/ping.inet"
	wait
	PINGS="$(cat "$RUN_DIR/ping.modem"),$(cat "$RUN_DIR/ping.inet")"
	rm -f "$RUN_DIR/ping.modem" "$RUN_DIR/ping.inet"
}

# Gzip the days before today, and remove days older than HISTORY_DAYS.
tidy_store() {
	local cutoff f name
	cutoff=$(date -d "@$(( $(date +%s) - HISTORY_DAYS * 86400 ))" +%Y%m%d 2>/dev/null) || return 0
	for f in "$DATA_DIR"/readings/*.csv* "$DATA_DIR"/channels/*.csv* "$DATA_DIR"/events/*.csv* "$DATA_DIR"/radios/*.csv*; do
		[ -e "$f" ] || continue
		name=${f##*/}; name=${name%%.*}
		case $name in [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;; *) continue ;; esac
		if [ "$(echo "$name" | tr -d -)" -lt "$cutoff" ]; then
			rm -f "$f"
		elif [ "$name" != "$DAY" ] && [ "${f%.gz}" = "$f" ]; then
			gzip -f "$f"
		fi
	done
	tidy_lineup
	tidy_restarts
}

# Restarts older than the history kept, when there are any.
tidy_restarts() {
	local f="$DATA_DIR/restarts.csv" first since
	[ -s "$f" ] || return 0
	since=$(( $(date +%s) - HISTORY_DAYS * 86400 ))
	first=$(sed -n '2s/,.*//p' "$f")
	[ -n "$first" ] && [ "$(int_or "$first" 0)" -lt "$since" ] || return 0
	awk -F, -v since="$since" 'NR == 1 || $1 + 0 >= since' "$f" > "$f.new" && mv -f "$f.new" "$f"
}

# The line-up file, once a day (and after a start): drop entries that only
# repeat the one before them for their channel, and entries from before
# the history that is kept, except the newest of each channel (the line-up
# as it was when the kept history begins).
tidy_lineup() {
	local f="$DATA_DIR/channelmap.csv" tmp="$RUN_DIR/channelmap.tidy" cut
	[ -s "$f" ] || return 0
	[ "$(cat "$RUN_DIR/lineup_tidied" 2>/dev/null)" = "$DAY" ] && return 0
	echo "$DAY" > "$RUN_DIR/lineup_tidied"
	cut=$(( $(date +%s) - HISTORY_DAYS * 86400 ))
	awk -F, -v cut="$cut" '
		NR == 1 { print; next }
		{
			k = $2 "," $4; v = $3 "," $5 "," $6 "," $7
			if ((k in seen) && seen[k] == v) next
			seen[k] = v
			if ($1 + 0 < cut) { if (!(k in old)) order[++n] = k; old[k] = $0 }
			else later[++m] = $0
		}
		END { for (i = 1; i <= n; i++) print old[order[i]]; for (i = 1; i <= m; i++) print later[i] }
	' "$f" > "$tmp" || return 0
	if [ -s "$tmp" ] && [ "$(md5sum < "$tmp")" != "$(md5sum < "$f")" ]; then
		cp "$tmp" "$f.new" && mv -f "$f.new" "$f"
	fi
	rm -f "$tmp"
}

# Previous good check, from DATA_DIR/last:
#   line 1: "ts uptime"; then "dir,channel_id,corrected,uncorrectable" totals.
read_last() {
	PREV_TS=; PREV_UPTIME=
	[ -s "$DATA_DIR/last" ] || return 1
	read -r PREV_TS PREV_UPTIME < "$DATA_DIR/last"
	PREV_TS=$(int_or "$PREV_TS" ""); PREV_UPTIME=$(int_or "$PREV_UPTIME" "")
	[ -n "$PREV_TS" ] && [ -n "$PREV_UPTIME" ]
}

# Store the channels of a good check. $1=ts $2=reboot(0/1) $3=full rows
# (ts,dir,ch,lock,modulation,channel_id,freq_hz,width_hz,power,snr,corrected,uncorrectable).
# The modem's error counters run since its last restart, so each row stores
# the change since the previous good check: after a restart, or when a
# counter went down, the change is the new count itself; with no earlier
# check for the channel it is left empty (unknown), never guessed.
store_channels() {
	local ts=$1 reboot=$2 rows=$3 map
	printf '%s\n' "$rows" | awk -F, -v reboot="$reboot" -v last="$DATA_DIR/last" -v state="$DATA_DIR/last.new" -v out="$CHANNELS" '
		BEGIN {
			# line 1 of "last" is "ts uptime"; then dir,channel_id,corrected,uncorrectable
			n = 0
			while ((getline line < last) > 0) {
				if (++n == 1) continue
				split(line, p, ",")
				prev[p[1] "," p[2]] = p[3]; prevu[p[1] "," p[2]] = p[4]
			}
			close(last)
		}
		$0 == "" { next }
		{
			k = $2 "," $6; dc = ""; du = ""
			if ($2 == "ds" && $11 != "") {
				if (reboot == 1) { dc = $11; du = $12 }
				else if (k in prev) {
					dc = ($11 + 0 >= prev[k] + 0) ? $11 - prev[k] : $11
					du = ($12 + 0 >= prevu[k] + 0) ? $12 - prevu[k] : $12
				}
				print k "," $11 "," $12 >> state
			}
			print $1 "," $2 "," $6 "," $4 "," $9 "," $10 "," dc "," du >> out
		}'

	# The line-up: an entry only for a channel whose entry changed. A
	# channel that lost lock reports no modulation ("Unknown"); that is not
	# a change of the line-up (its lock state is in its row above), so it
	# keeps the modulation it had. On a line whose channels keep losing
	# lock, storing the whole line-up at each such moment came to about
	# 115 KB a day.
	map="$RUN_DIR/channelmap.new"
	printf '%s\n' "$rows" | awk -F, -v ts="$ts" -v last="$DATA_DIR/channelmap.last" -v new="$map" -v out="$DATA_DIR/channelmap.csv" '
		BEGIN {
			printf "" > new
			while ((getline line < last) > 0) {
				split(line, p, ",")
				prev[p[1] "," p[3]] = line; prevmod[p[1] "," p[3]] = p[4]
			}
			close(last)
		}
		NF {
			k = $2 "," $6; mod = $5
			if (tolower(mod) == "unknown" && (k in prev) && prevmod[k] != "") mod = prevmod[k]
			row = $2 "," $3 "," $6 "," mod "," $7 "," $8
			print row >> new
			if (!(k in prev) || prev[k] != row) print ts "," row >> out
		}'
	# Flash is only written when the line-up differs.
	if [ -s "$map" ] && [ "$(cat "$map")" != "$(cat "$DATA_DIR/channelmap.last" 2>/dev/null)" ]; then
		cp "$map" "$DATA_DIR/channelmap.last.new" && mv -f "$DATA_DIR/channelmap.last.new" "$DATA_DIR/channelmap.last"
	fi
	rm -f "$map"
}

# The modem's clock minus the router's, in seconds ("" if unknown).
# $1=ts $2=modem time "MM/DD/YYYY HH:MM:SS" (the modem's local time)
clock_offset() {
	local iso m
	iso=$(printf '%s' "$2" | awk '{ split($1, d, "/"); if (d[3] != "") printf "%04d-%02d-%02d %s", d[3], d[1], d[2], $2 }')
	[ -n "$iso" ] || return 0
	m=$(date -d "$iso" +%s 2>/dev/null) || return 0
	echo $(( m - $1 ))
}

# Store the event log entries not seen in the previous read. The modem
# keeps its last 100 entries (newest first) and drops the oldest, so an
# entry is identified by its time and message. Its own web logins are not
# stored (the router's logins would drown out the line's events), and
# neither are IP addresses or the MAC/version suffix of CM-STATUS lines.
# $1=ts $2=log text $3=clock offset
store_events() {
	local ts=$1 offset=$3
	printf '%s' "$2" | tr -d '\000-\037",\\<>' | awk -v ts="$ts" -v offset="$offset" -v seen="$DATA_DIR/events.seen" \
		-v newseen="$DATA_DIR/events.seen.new" -v out="$EVENTS" '
		BEGIN { while ((getline line < seen) > 0) old[line] = 1; close(seen) }
		{
			n = split($0, e, /\}-\{/)
			for (i = n; i >= 1; i--) {   # oldest first
				split(e[i], f, /\^/)
				when = f[2]; level = f[4]; msg = f[5]
				if (when == "" || msg ~ /WebGUI login/) continue
				sub(/;CM-MAC=.*$/, "", msg)
				gsub(/([0-9]+\.){3}[0-9]+/, "x.x.x.x", msg)
				key = when "^" msg
				print key > newseen
				if (key in old) continue
				old[key] = 1
				print ts "," when "," offset "," level "," msg >> out
				added++
			}
		}
		END { printf "%d", added + 0 }'
	mv -f "$DATA_DIR/events.seen.new" "$DATA_DIR/events.seen" 2>/dev/null
}

# ------------------------------------------------------- copy on a drive
#
# With export_dir set, a copy for use without the router is kept in that
# folder on an attached drive:
#   modemhealth-readings.csv, -channels.csv, -events.csv
#                             the history. After every check the rows the
#                             drive does not have yet are added at the end;
#                             nothing is rewritten, so a drive that was away
#                             is brought up to date by the next check, and
#                             the files keep growing after the router has
#                             dropped its own old days.
#   modemhealth-lineup.csv    the channel line-up (when it changed)
#   modemhealth-outages.csv   the outages in the readings file (when changed)
#   modemhealth-report.html   the report: the last REPORT_DAYS days of
#                             history and the report's own code in one file
#                             that any browser opens. It holds megabytes, so
#                             it is written once a day and on "save now",
#                             not at every check, to spare the drive.
# The folder must be on a drive that is attached right now: the mount point
# of an unplugged drive is a folder in the router's RAM or flash, exactly
# where a copy must not go. That is checked before anything is created. When
# the copy cannot be written, nothing is written anywhere else, the reason
# is kept for the status display, and the next check tries again.

# Mount point and filesystem type holding a path: the longest match in
# /proc/mounts (a later mount on the same point wins).
mount_of() { # $1=absolute path
	awk -v p="$1" '
		{
			m = $2
			if (m == "/" || p == m || index(p, m "/") == 1)
				if (length(m) >= length(best)) { best = m; fs = $3 }
		}
		END { if (best != "") print best, fs }' /proc/mounts 2>/dev/null
}

# Filesystems that are the router itself (its flash, its RAM, the kernel)
# rather than something plugged into it.
internal_fs() {
	case "$1" in
		''|rootfs|overlay|squashfs|jffs2|ubifs|tmpfs|ramfs|devtmpfs|devpts|proc|sysfs) return 0 ;;
		debugfs|tracefs|pstore|bpf|cgroup*|autofs|mqueue|securityfs|configfs|fusectl) return 0 ;;
	esac
	return 1
}

# Nearest existing directory at or above a path, with symlinks resolved.
existing_dir() { # $1=absolute path
	local d="$1"
	while [ -n "$d" ] && [ ! -d "$d" ]; do d=${d%/*}; done
	( cd "${d:-/}" 2>/dev/null && pwd -P )
}

# True when a folder is, or would be created, on an attached drive.
on_drive() { # $1=folder
	# shellcheck disable=SC2046
	set -- $(mount_of "$(existing_dir "$1")")
	case "$1" in ''|/|/rom|/overlay) return 1 ;; esac
	! internal_fs "$2"
}

# Mount points of attached, writable drives, as suggestions for Settings.
list_drives() {
	local mp fs opts
	while read -r _ mp fs opts _; do
		case "$opts" in ro|ro,*) continue ;; esac
		case "$mp" in
			/|/rom*|/overlay*|/boot*|/proc*|/sys*|/dev*|/etc*|/lib*|/usr*|/www*|/bin*|/sbin*) continue ;;
			*[!A-Za-z0-9._/-]*) continue ;;
		esac
		internal_fs "$fs" && continue
		[ -d "$mp" ] && echo "$mp"
	done < /proc/mounts | sort -u
}

# Outcome of the last attempt: time, ok|nodrive|error, folder, reason.
export_state() { # $1=ok|nodrive|error $2=reason
	mkdir -p "$RUN_DIR"
	printf '%s\n%s\n%s\n%s\n' "$(date +%s)" "$1" "$EXPORT_DIR" "$2" > "$RUN_DIR/export"
}

export_fail() { # $1=nodrive|error $2=reason; logged once, not after every check
	[ "$(sed -n '2,4p' "$RUN_DIR/export" 2>/dev/null | tr '\n' '|')" = "$1|$EXPORT_DIR|$2|" ] ||
		log "copy to $EXPORT_DIR not saved: $2"
	export_state "$1" "$2"
	return 1
}

# Add the rows of one kind that the drive's file does not have yet: those
# after the last one it holds.
export_append() { # $1=kind $2=header
	local dest="$EXPORT_DIR/modemhealth-$1.csv" last=0
	# A kind this router has never stored (radios behind a cable modem).
	[ -d "$DATA_DIR/$1" ] || [ -e "$dest" ] || return 0
	if [ -s "$dest" ]; then
		last=$(int_or "$(tail -c 4096 "$dest" | tail -n 1 | cut -d, -f1)" 0)
	else
		echo "$2" > "$dest" || return 1
	fi
	rows_between "$1" $(( last + 1 )) 9999999999 >> "$dest" || return 1
}

# Replace a file on the drive when what it should hold has changed. The new
# content is written next to it and renamed once complete, so a half-written
# file never replaces a good one.
export_replace() { # $1=name; content on stdin
	local dest="$EXPORT_DIR/$1"
	cat > "$dest.part" || { rm -f "$dest.part"; return 1; }
	if [ -e "$dest" ] && [ "$(md5sum < "$dest")" = "$(md5sum < "$dest.part")" ]; then
		rm -f "$dest.part"
	else
		mv -f "$dest.part" "$dest" || { rm -f "$dest.part"; return 1; }
	fi
}

# The outages in a readings file, as the pages work them out (health.js:
# outages; both are checked against tests/fixtures/outages). An outage runs
# from the first to the last check in a row that got no answer from the
# internet; min_s is what those checks prove, max_s the time between the
# good checks around it (empty: unknown).
outages_csv() { # $1=readings csv
	awk -F, -v gap="$(( INTERVAL * 180 > 1800 ? INTERVAL * 180 : 1800 ))" '
		function when(t) { return strftime("%Y-%m-%d %H:%M:%S", t) }
		NR == 1 || $18 == "" || $1 !~ /^[0-9]+$/ { next }
		{
			ts = $1 + 0
			if (open && prev != "" && ts - prev > gap) { a[n] = ""; open = 0 }
			if ($18 + 0 == 100) {
				if (!open) {
					open = 1; n++; s[n] = ts; c[n] = 0; k[n] = "line_down"
					b[n] = (good != "" && ts - good <= gap) ? good : ""
				}
				e[n] = ts; c[n]++
				if (($16 != "" && $16 + 0 == 100) || ($2 == "failed" && ($3 == "unreachable" || $3 == "timeout"))) k[n] = "modem_unreachable"
			} else {
				if (open) { a[n] = ts; open = 0 }
				good = ts
			}
			prev = ts; lastts = ts
		}
		END {
			if (open) a[n] = ""
			print "start,start_time,end,end_time,kind,checks,min_s,max_s,ongoing"
			for (i = 1; i <= n; i++)
				print s[i] "," when(s[i]) "," e[i] "," when(e[i]) "," k[i] "," c[i] "," e[i] - s[i] "," \
					((b[i] != "" && a[i] != "") ? a[i] - b[i] : "") "," ((a[i] == "" && e[i] == lastts) ? 1 : 0)
		}' "$1"
}

cfg_json() { json_str "$(uci -q get "$CONFIG.main.$1")"; }

# The report file. It carries the last REPORT_DAYS days of history, the
# settings the report needs and the modules the Report page uses, so it
# draws the same report in any browser, without the router (see
# standalone.js). The modem password is not among what it carries.
report_html() {
	local f k v since first=1
	for f in "$SHARE/standalone.html" "$SHARE/standalone.js" "$WWW/health.js" "$WWW/common.js" "$WWW/report.js"; do
		[ -r "$f" ] || return 1
	done
	since=$(( $(date +%s) - REPORT_DAYS * 86400 ))
	cat "$SHARE/standalone.html" || return 1
	# The history as text; "&" and "<" are the only characters that mean
	# anything to a browser there.
	for k in readings channels events radios; do
		printf '<pre hidden id="mh-%s">\n' "$k"
		{
			case $k in readings) echo "$READINGS_HEADER" ;; channels) echo "$CHANNELS_HEADER" ;; events) echo "$EVENTS_HEADER" ;; radios) echo "$RADIOS_HEADER" ;; esac
			rows_between "$k" "$since" 9999999999
		} | sed 's/&/\&amp;/g; s/</\&lt;/g'
		printf '</pre>\n'
	done
	printf '<pre hidden id="mh-channelmap">\n'
	lineup_between "$since" 9999999999 | sed 's/&/\&amp;/g; s/</\&lt;/g'
	printf '</pre>\n'
	# ISPy's speed tests of those days, if it has any (numbers only).
	if f=$(ispy_results) && k=$(speed_rows "$f" "$since" 9999999999) && [ -n "$k" ]; then
		printf '<pre hidden id="mh-speedtests">\n%s\n</pre>\n' "$k"
	fi
	printf '<script type="application/json" id="mh-ctx">\n'
	{
		printf '{"exported":%s,"since":%s,"version":%s,"interval":%s,"ping_host":%s,' \
			"$(date +%s)" "$since" "$(json_str "$VERSION")" "$INTERVAL" "$(json_str "$PING_HOST")"
		printf '"speed":{"plan_down":%s,"plan_up":%s},' \
			"$(json_str "$(uci -q get ispy.main.plan_down)")" "$(json_str "$(uci -q get ispy.main.plan_up)")"
		printf '"sub":{"isp":%s,"subscriber":%s,"account":%s,"address":%s},"modem":{' \
			"$(cfg_json isp_name)" "$(cfg_json subscriber)" "$(cfg_json account)" "$(cfg_json service_address)"
		if [ -s "$DATA_DIR/modem.txt" ]; then
			while IFS='=' read -r k v; do
				[ -n "$k" ] || continue
				[ $first = 1 ] || printf ','
				first=0
				printf '%s:%s' "$(json_str "$k")" "$(json_str "$v")"
			done < "$DATA_DIR/modem.txt"
		fi
		printf '},"limits":{'
		first=1
		uci -q show "$CONFIG.limits" | sed -n "s/^$CONFIG\\.limits\\.\\([a-z0-9_]*\\)='\\(.*\\)'\$/\\1 \\2/p" | while read -r k v; do
			[ $first = 1 ] || printf ','
			first=0
			printf '%s:%s' "$(json_str "$k")" "$(json_str "$v")"
		done
		printf '}}\n'
	} | sed 's/</\\u003c/g'
	printf '</script>\n<script>\nvar MH_MODULES = {};\nMH_MODULES.health = function(baseclass) {\n'
	cat "$WWW/health.js" || return 1
	printf '\n};\nMH_MODULES.common = function(baseclass, rpc, health) {\n'
	cat "$WWW/common.js" || return 1
	printf '\n};\nMH_MODULES.report = function(baseclass, mh) {\n'
	cat "$WWW/report.js" || return 1
	printf '\n};\n</script>\n<script>\n'
	cat "$SHARE/standalone.js" || return 1
	printf '</script>\n</body>\n</html>\n'
}

export_files() { # $1=1: write the report file whatever its age
	local dir="$EXPORT_DIR" report="$EXPORT_DIR/modemhealth-report.html"
	if ! on_drive "$dir"; then
		export_fail nodrive "the folder is not on a connected drive"
		return 1
	fi
	if ! mkdir -p "$dir" 2>/dev/null || [ ! -d "$dir" ]; then
		export_fail error "the folder cannot be created on the drive (read-only?)"
		return 1
	fi
	ensure_store 2>/dev/null
	if ! { export_append readings "$READINGS_HEADER" && export_append channels "$CHANNELS_HEADER" &&
		export_append events "$EVENTS_HEADER" && export_append radios "$RADIOS_HEADER" && export_replace modemhealth-lineup.csv < "$DATA_DIR/channelmap.csv" &&
		outages_csv "$dir/modemhealth-readings.csv" | export_replace modemhealth-outages.csv; } 2>/dev/null; then
		export_fail error "the drive cannot be written to (full or read-only?)"
		return 1
	fi
	# Once a day, and when asked for.
	if [ "$1" = 1 ] || [ ! -s "$report" ] || [ "$(date -r "$report" +%Y-%m-%d 2>/dev/null)" != "$(today)" ]; then
		if ! { report_html > "$report.part" && mv -f "$report.part" "$report"; } 2>/dev/null; then
			rm -f "$report.part" 2>/dev/null
			export_fail error "the history was saved, but the report file could not be written"
			return 1
		fi
	fi
	sync
	[ "$(sed -n 2p "$RUN_DIR/export" 2>/dev/null)" = ok ] || log "history and report saved to $dir"
	export_state ok ""
}

export_now() { # $1=1: with the report file
	local lock="$RUN_DIR/export.lock" pid rc=0
	[ -n "$EXPORT_DIR" ] || return 0
	mkdir -p "$RUN_DIR"
	# One writer at a time ("save now" pressed while a check finishes).
	if ! mkdir "$lock" 2>/dev/null; then
		pid=$(cat "$lock/pid" 2>/dev/null)
		[ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && return 0
		rm -rf "$lock"
		mkdir "$lock" 2>/dev/null || return 0
	fi
	read -r pid _ < /proc/self/stat
	echo "$pid" > "$lock/pid"
	# Readable by whoever plugs the drive into a computer, whatever umask
	# the caller (rpcd, procd) happens to run with.
	( umask 022; export_files "$1" ) || rc=1
	rm -rf "$lock"
	return "$rc"
}

# The state of the copy, for the pages.
export_json() {
	local ts="" state="" dir="" msg="" mounted=false
	if [ -n "$EXPORT_DIR" ]; then
		on_drive "$EXPORT_DIR" && mounted=true
		if [ -s "$RUN_DIR/export" ]; then
			{ read -r ts; read -r state; read -r dir; read -r msg; } < "$RUN_DIR/export"
			# About another folder: the setting has changed since.
			[ "$dir" = "$EXPORT_DIR" ] || { ts=""; state=""; msg=""; }
		fi
	fi
	printf '{"dir":%s,"mounted":%s,"ts":%s,"ok":%s,"message":%s}' "$(json_str "$EXPORT_DIR")" "$mounted" "$(json_num "$ts")" \
		"$(case $state in ok) echo true ;; '') echo null ;; *) echo false ;; esac)" "$(json_str "$msg")"
}

do_export() {
	load_config
	export_now 1
	export_json
	echo
}

# "Clear history" must not take the copy on the drive with it (the next
# check would carry on in the same files), so that copy is first set aside
# under a dated name.
archive_export() {
	local dir="$EXPORT_DIR" stamp f base kept=0
	[ -n "$dir" ] || return 0
	on_drive "$dir" || return 0
	stamp=$(date +%Y%m%d-%H%M%S)
	for f in "$dir"/modemhealth-readings.csv "$dir"/modemhealth-channels.csv "$dir"/modemhealth-events.csv "$dir"/modemhealth-radios.csv \
		"$dir"/modemhealth-lineup.csv "$dir"/modemhealth-outages.csv "$dir"/modemhealth-report.html; do
		[ -e "$f" ] || continue
		base=${f##*/}
		mv "$f" "$dir/${base%.*}-until-$stamp.${base##*.}" 2>/dev/null && kept=1
	done
	sync
	[ $kept = 1 ] && log "history cleared; the copy on the drive was kept under names ending in -until-$stamp"
	return 0
}

do_clear() {
	load_config
	archive_export
	rm -rf "$DATA_DIR/readings" "$DATA_DIR/channels" "$DATA_DIR/events" "$DATA_DIR/radios"
	rm -f "$DATA_DIR/radios.last" "$DATA_DIR/restarts.csv" "$DATA_DIR/events.seen" "$DATA_DIR/channelmap.csv" "$DATA_DIR/channelmap.last" "$DATA_DIR/last" "$RUN_DIR/export" "$RUN_DIR/lineup_tidied"
	ensure_store
	log "history cleared"
	echo '{"cleared":true}'
}

# ---------------------------------------------------------------------- check

# A check of a T-Mobile gateway. Sets nothing on the gateway and needs no
# password. Readings keep: registration (connectivity), home/roaming
# (network_access), the gateway's clock (modem_time) and uptime; the
# cable-only columns stay empty. The radios go to radios/.
gw_check() {
	local ts=$1 rows uptime="" model firmware reboot=0 boot_ts="" modem_time="" offset="" lt registration roaming n changes
	if { [ -z "$GW_PORT" ] || [ ! -s "$RUN_DIR/gateway.json" ]; } && ! gw_read; then
		store_failed "$ts" "$FAIL_REASON"
		log "check failed: $FAIL_REASON"
		export_now
		echo "failed: $FAIL_REASON"
		return 1
	fi
	rows=$(gw_radio_rows "$ts")
	n=$(printf '%s' "$rows" | grep -c .)
	uptime=$(int_or "$(gw_field '.time.upTime' | cut -d. -f1)" "")
	model=$(clean "$(gw_field '.device.model')")
	firmware=$(clean "$(gw_field '.device.softwareVersion')")
	registration=$(clean "$(gw_field '.signal.generic.registration')")
	roaming=$(gw_field '.signal.generic.roaming')
	case $roaming in true) roaming=roaming ;; false) roaming=home ;; *) roaming= ;; esac
	lt=$(int_or "$(gw_field '.time.localTime' | cut -d. -f1)" "")
	if [ -n "$lt" ]; then
		modem_time=$(date -d "@$lt" '+%Y-%m-%d %H:%M:%S' 2>/dev/null)
		offset=$(( ts - lt ))
	fi

	if [ -n "$uptime" ] && read_last && [ "$ts" -ge "$PREV_TS" ] \
		&& [ $(( uptime + 120 )) -lt $(( PREV_UPTIME + ts - PREV_TS )) ]; then
		reboot=1
		boot_ts=$(( ts - uptime ))
		log "gateway restarted at $(date -d "@$boot_ts" '+%Y-%m-%d %H:%M:%S' 2>/dev/null)"
	fi

	changes=$(gw_store_radios "$ts" "$rows" "$modem_time" "$offset")
	echo "$ts ${uptime:-0}" > "$DATA_DIR/last.new" && mv -f "$DATA_DIR/last.new" "$DATA_DIR/last"
	echo "$ts,ok,,$model,$firmware,$uptime,$registration,,$roaming,$modem_time,,,$reboot,$boot_ts,$offset,$PINGS" >> "$READINGS"
	{
		echo "type=tmobile"
		echo "model=$model"
		echo "firmware=$firmware"
		echo "mac=$(clean "$(gw_field '.device.macId')")"
		echo "maker=$(clean "$(gw_field '.device.manufacturer')")"
	} > "$DATA_DIR/modem.txt.new" && mv -f "$DATA_DIR/modem.txt.new" "$DATA_DIR/modem.txt"
	rm -f "$RUN_DIR/gateway.json"
	export_now
	echo "ok: $model, $n radio(s), ${registration:-registration unknown}, up ${uptime:-?}s${changes:+, $changes}$([ $reboot = 1 ] && echo ', restarted since the last check')"
}

# Store the radios of a good check, and an event for each tower or band
# change since the previous good check. Prints what changed, if anything.
# $1=ts $2=rows $3=gateway time $4=clock offset
gw_store_radios() {
	local ts=$1 rows=$2 day f
	day=$(today)
	mkdir -p "$DATA_DIR/radios" || return 1
	f="$DATA_DIR/radios/$day.csv"
	[ -s "$f" ] || echo "$RADIOS_HEADER" > "$f"
	[ -n "$rows" ] && printf '%s\n' "$rows" >> "$f"
	printf '%s\n' "$rows" | awk -F, -v prev="$DATA_DIR/radios.last" -v nextf="$DATA_DIR/radios.last.new" \
		-v ts="$ts" -v when="$3" -v offset="$4" -v out="$EVENTS" '
		BEGIN { while ((getline line < prev) > 0) { split(line, p, " "); cell[p[1]] = p[2]; bands[p[1]] = p[3]; had[p[1]] = 1 } close(prev) }
		$2 == "" { next }
		{
			name = ($2 == "nr" ? "5G" : "4G"); b = $3; gsub(/ /, "+", b)
			print $2, ($9 == "" ? "-" : $9), (b == "" ? "-" : b) > nextf
			seen[$2] = 1
			if (!($2 in had)) next
			if ($9 != "" && cell[$2] != "-" && $9 != cell[$2]) {
				print ts "," when "," offset ",Notice,Tower change on " name ": " cell[$2] " to " $9 >> out; n++
			}
			if (b != "" && bands[$2] != "-" && b != bands[$2]) {
				print ts "," when "," offset ",Notice,Band change on " name ": " bands[$2] " to " b >> out; n++
			}
		}
		END {
			for (t in had) if (!(t in seen)) {
				print ts "," when "," offset ",Notice," (t == "nr" ? "5G" : "4G") " radio no longer connected" >> out; n++
			}
			if (n) printf "%d tower/band change(s)", n
		}'
	mv -f "$DATA_DIR/radios.last.new" "$DATA_DIR/radios.last" 2>/dev/null || : > "$DATA_DIR/radios.last"
}

do_check() {
	local ts rows ds us ds_n us_n uptime model firmware reboot=0 boot_ts="" modem_time offset new_events
	load_config
	mkdir -p "$RUN_DIR" && chmod 700 "$RUN_DIR"
	ensure_store || { log "cannot write to $DATA_DIR"; return 1; }
	tidy_store
	ts=$(date +%s)
	FAIL_REASON=
	measure_pings
	GW_PORT=
	detect_device
	if [ "$DEVICE" = tmobile ]; then
		gw_check "$ts"
		return $?
	fi

	if ! modem_read_with_session; then
		[ "$FAIL_REASON" = login_refused ] && session_drop
		store_failed "$ts" "$FAIL_REASON"
		rm -f "$RUN_DIR/status.json"
		log "check failed: $FAIL_REASON"
		export_now
		echo "failed: $FAIL_REASON"
		return 1
	fi

	[ "$MODEM_TYPE" = auto ] && echo surfboard > "$RUN_DIR/device"
	ds=$(status_field GetCustomerStatusDownstreamChannelInfo CustomerConnDownstreamChannel)
	us=$(status_field GetCustomerStatusUpstreamChannelInfo CustomerConnUpstreamChannel)
	rows=$( { channel_rows "$ts" ds "$ds"; channel_rows "$ts" us "$us"; } )
	ds_n=$(printf '%s\n' "$rows" | grep -c '^[0-9]*,ds,')
	us_n=$(printf '%s\n' "$rows" | grep -c '^[0-9]*,us,')
	uptime=$(uptime_seconds "$(status_field GetCustomerStatusSoftware CustomerConnSystemUpTime)")
	model=$(clean "$(status_field GetCustomerStatusSoftware StatusSoftwareModelName)")
	firmware=$(clean "$(status_field GetCustomerStatusSoftware StatusSoftwareSfVer)")

	# A restart: the modem has been up for less time than has passed since
	# the previous good check (two minutes' grace for clock jitter).
	if [ -n "$uptime" ] && read_last && [ "$ts" -ge "$PREV_TS" ] \
		&& [ $(( uptime + 120 )) -lt $(( PREV_UPTIME + ts - PREV_TS )) ]; then
		reboot=1
		boot_ts=$(( ts - uptime ))
		log "modem restarted at $(date -d "@$boot_ts" '+%Y-%m-%d %H:%M:%S' 2>/dev/null)"
	fi

	modem_time=$(clean "$(status_field GetCustomerStatusConnectionInfo CustomerCurSystemTime)")
	offset=$(clock_offset "$ts" "$modem_time")
	new_events=$(store_events "$ts" "$(status_field GetCustomerStatusLog CustomerStatusLogList)" "$offset")

	echo "$ts ${uptime:-0}" > "$DATA_DIR/last.new"
	[ -n "$rows" ] && store_channels "$ts" "$reboot" "$rows"
	mv -f "$DATA_DIR/last.new" "$DATA_DIR/last"
	echo "$ts,ok,,$model,$firmware,$uptime,$(clean "$(status_field GetCustomerStatusStartupSequence CustomerConnConnectivityComment)"),$(clean "$(status_field GetCustomerStatusStartupSequence CustomerConnBootComment)"),$(clean "$(status_field GetCustomerStatusConnectionInfo CustomerConnNetworkAccess)"),$modem_time,$ds_n,$us_n,$reboot,$boot_ts,$offset,$PINGS" >> "$READINGS"

	# What identifies the modem to the ISP; overwritten on every good reading.
	{
		echo "type=surfboard"
		echo "model=$model"
		echo "firmware=$firmware"
		echo "mac=$(clean "$(status_field GetCustomerStatusSoftware StatusSoftwareMac)")"
		echo "docsis=$(clean "$(status_field GetCustomerStatusSoftware StatusSoftwareCustomerVer)")"
	} > "$DATA_DIR/modem.txt.new" && mv -f "$DATA_DIR/modem.txt.new" "$DATA_DIR/modem.txt"

	rm -f "$RUN_DIR/status.json"
	export_now
	echo "ok: $model, $ds_n downstream and $us_n upstream channels, up ${uptime}s, ${new_events:-0} new events$([ $reboot = 1 ] && echo ', restarted since the last check')"
}

# ------------------------------------------------------------------- restart
#
# Restarting is the one thing Modem Health does to the modem; everything
# else only reads. Every attempt is kept, in restarts.csv (for the limits
# on automatic restarts and for the report) and as an event in the day's
# events file, so that the report can tell a restart Modem Health made
# from one the modem made on its own, and never blames the line for it.
# TRIGGER: manual (the Restart button), down (no connection) or signal
# (bad signal); DETAIL: why, in words.

record_restart() { # $1=ts $2=trigger $3=ok|failed $4=detail $5=fail reason
	local f="$DATA_DIR/restarts.csv" msg
	[ -s "$f" ] || echo "$RESTARTS_HEADER" > "$f"
	echo "$1,$2,$3,$(clean "$4"),$(clean "$5")" >> "$f"
	if [ "$3" = ok ]; then
		msg="Restarted by Modem Health: $4"
	else
		msg="Modem Health could not restart the modem ($5): $4"
	fi
	echo "$1,,,Notice,$(clean "$msg")" >> "$EVENTS"
}

# restart_modem TRIGGER DETAIL: the restart, with the lock already held.
# Prints the result as JSON.
restart_modem() {
	local ts trigger=$1 detail=$2
	ts=$(date +%s)
	FAIL_REASON=
	GW_PORT=
	detect_device
	if { [ "$DEVICE" = tmobile ] && gw_restart; } || { [ "$DEVICE" != tmobile ] && modem_with_session modem_restart; }; then
		# The modem forgets its sessions when it restarts.
		[ "$DEVICE" = tmobile ] || session_drop
		record_restart "$ts" "$trigger" ok "$detail" ""
		log "restarted the modem ($trigger: $detail)"
		printf '{"ok":true,"device":%s,"ts":%s}\n' "$(json_str "$DEVICE")" "$ts"
		return 0
	fi
	record_restart "$ts" "$trigger" failed "$detail" "$FAIL_REASON"
	log "could not restart the modem: $FAIL_REASON"
	printf '{"ok":false,"device":%s,"reason":%s}\n' "$(json_str "$DEVICE")" "$(json_str "$FAIL_REASON")"
	return 1
}

do_restart() { # $1=trigger $2=detail
	local trigger=${1:-manual} detail=$2
	case $trigger in manual|down|signal) ;; *) echo '{"ok":false,"reason":"bad_trigger"}'; return 2 ;; esac
	[ -n "$detail" ] || detail="asked for by hand"
	load_config
	mkdir -p "$RUN_DIR" && chmod 700 "$RUN_DIR"
	ensure_store || { echo '{"ok":false,"reason":"cannot_store"}'; return 1; }
	restart_modem "$trigger" "$detail"
}

# Checks and restarts take turns: both use the kept session and the
# modem's timestamp rule.
with_lock() {
	local dir=${MODEMHEALTH_RUN_DIR:-/var/run/modemhealth}
	mkdir -p "$dir" && chmod 700 "$dir"
	( flock -x 9 && "$@" ) 9>"$dir/lock"
}

do_logout() {
	load_config
	mkdir -p "$RUN_DIR" && chmod 700 "$RUN_DIR"
	session_load && modem_logout
	session_drop
}

# All stored readings, oldest first, without headers.
all_readings() {
	local f
	for f in "$DATA_DIR"/readings/*.csv.gz "$DATA_DIR"/readings/*.csv; do
		[ -e "$f" ] || continue
		case $f in *.gz) gzip -dc "$f" ;; *) cat "$f" ;; esac | tail -n +2
	done
}

do_last() {
	load_config
	local r
	r=$(all_readings | tail -n 1)
	[ -n "$r" ] || { echo "no readings yet"; return 1; }
	echo "$r"
}

do_history() {
	load_config
	all_readings | tail -n "$(int_or "$1" 12)" | awk -F, '{
		cmd = "date -d @" $1 " \"+%Y-%m-%d %H:%M:%S\""; cmd | getline when; close(cmd)
		if ($2 == "ok")
			printf "%s  ok      up %dd %02dh%02dm  %s ds / %s us%s\n", when, $6 / 86400, ($6 % 86400) / 3600, ($6 % 3600) / 60, $11, $12, ($13 == 1 ? "  RESTARTED" : "")
		else
			printf "%s  FAILED  %s\n", when, $3
	}'
}

# --------------------------------------------------------------------- daemon

uptime_s() { local u; read -r u _ < /proc/uptime; echo "${u%.*}"; }

# Interruptible sleep (lets the TERM trap run straight away).
nap() { sleep "$1" & SLEEP_PID=$!; wait "$SLEEP_PID"; }

# The router has no battery-backed clock: until NTP has set the time a
# reading would carry the wrong date, which is worthless as evidence. The
# ntp hotplug (shipped with dnsmasq) leaves a flag once the time is valid;
# without that flag, give NTP ten minutes.
time_synced() {
	[ -e /var/state/dnsmasqsec ] && return 0
	[ "$(uptime_s)" -ge 600 ]
}

# Up to 20 seconds, so checks don't always land on the same second.
jitter() { awk 'BEGIN { srand(); print int(rand() * 20) }'; }

do_daemon() {
	local base="" up due last t
	SLEEP_PID=""; CHECK_PID=""
	trap 'kill $SLEEP_PID $CHECK_PID 2>/dev/null; do_logout >/dev/null 2>&1; rm -f "$RUN_DIR/next"; exit 0' INT TERM
	load_config
	mkdir -p "$RUN_DIR" && chmod 700 "$RUN_DIR"
	# Settings are re-read every minute, so changes apply even when procd's
	# config trigger does not restart us.
	while :; do
		load_config
		if [ "$ENABLED" != 1 ] || ! time_synced; then
			rm -f "$RUN_DIR/next"
			base=""
			nap 60
			continue
		fi
		# The schedule runs on the router's uptime, so clock steps (NTP
		# after boot) can neither stall it nor cause a burst of checks.
		up=$(uptime_s)
		t=$(date +%s)
		if [ -z "$base" ]; then
			# (Re)start: carry on from the last reading if it is recent,
			# otherwise check now.
			last=$(do_last 2>/dev/null | cut -d, -f1)
			last=$(int_or "$last" 0)
			if [ "$last" -gt 0 ] && [ "$last" -le "$t" ] && [ $(( t - last )) -lt $(( INTERVAL * 60 )) ]; then
				base=$(( up - (t - last) ))
			else
				base=$(( up - INTERVAL * 60 ))
			fi
		fi
		due=$(( base + INTERVAL * 60 ))
		if [ "$up" -lt "$due" ]; then
			echo $(( t + due - up )) > "$RUN_DIR/next"
			nap $(( due - up > 60 ? 60 : due - up ))
			continue
		fi
		base=$(( up + $(jitter) ))
		( with_lock do_check ) >/dev/null 2>&1 &
		CHECK_PID=$!
		wait "$CHECK_PID"
		CHECK_PID=""
	done
}

# --------------------------------------------------------- web interface

# Rows of one kind of daily file (readings, channels, events) with
# SINCE <= first column <= UNTIL, without headers. Only the days that can
# hold such rows are opened.
rows_between() { # $1=kind $2=since $3=until
	local f day from to
	from=$(date -d "@$(( $2 - 86400 ))" +%Y%m%d 2>/dev/null || echo 0)
	to=$(date -d "@$(( $3 + 86400 ))" +%Y%m%d 2>/dev/null || echo 99999999)
	for f in "$DATA_DIR/$1"/*.csv.gz "$DATA_DIR/$1"/*.csv; do
		[ -e "$f" ] || continue
		day=${f##*/}; day=$(echo "${day%%.*}" | tr -d -)
		case $day in *[!0-9]*|'') continue ;; esac
		[ "$day" -ge "$from" ] && [ "$day" -le "$to" ] || continue
		case $f in *.gz) gzip -dc "$f" ;; *) cat "$f" ;; esac | tail -n +2
	done | awk -F, -v s="$2" -v u="$3" '$1 + 0 >= s && $1 + 0 <= u'
}

# The line-up as it was at SINCE (the last entry of each channel before it)
# and every change up to UNTIL, with the header.
lineup_between() { # $1=since $2=until
	awk -F, -v s="$1" -v u="$2" '
		NR == 1 { print; next }
		$1 + 0 < s { k = $2 "," $4; if (!(k in last)) order[++n] = k; last[k] = $0; next }
		$1 + 0 <= u { later[++m] = $0 }
		END { for (i = 1; i <= n; i++) print last[order[i]]; for (i = 1; i <= m; i++) print later[i] }
	' "$DATA_DIR/channelmap.csv" 2>/dev/null
}

# Speed tests. ISPy (luci-app-ispy), a separate app, keeps its speed tests
# in a file of its own, named in its settings. When that file is there, the
# pages line the tests up with what the modem recorded, so the tests of a
# period are passed on: only the columns the pages use, found by name in
# ISPy's own header, and only values that are plain numbers. Nothing here
# needs ISPy to be installed, and without its file nothing is passed on.
SPEED_HEADER='ts,status,down_mbps,up_mbps,wan_down_mbps,wan_up_mbps'

# The file ISPy keeps its results in, if there is one to read. (Like ISPy
# itself: any other name than an absolute path to a .csv file means its
# default.)
ispy_results() {
	local f
	f=$(uci -q get ispy.main.results_file)
	case "$f" in /*.csv) ;; *) f=/etc/ispy/results.csv ;; esac
	[ -f "$f" ] && [ -r "$f" ] && echo "$f"
}

# ISPy's tests with SINCE <= time <= UNTIL, as SPEED_HEADER and rows. Fails,
# printing nothing, when the file is not ISPy's results as we know them.
speed_rows() { # $1=file $2=since $3=until
	awk -F, -v s="$2" -v u="$3" -v head="$SPEED_HEADER" '
		function plain(i) { return i && $i ~ /^[0-9]+(\.[0-9]+)?$/ ? $i : "" }
		NR == 1 {
			for (i = 1; i <= NF; i++) col[$i] = i
			ts = col["ts"]; st = col["status"]; down = col["down_mbps"]; up = col["up_mbps"]
			if (!ts || !st || !down || !up) exit 1
			print head
			next
		}
		$ts !~ /^[0-9]+$/ || $ts + 0 < s || $ts + 0 > u { next }
		# A test ISPy skipped (the line was busy) measured nothing.
		$st == "ok" || $st == "error" {
			printf "%s,%s,%s,%s,%s,%s\n", $ts, $st, plain(down), plain(up), plain(col["wan_down_mbps"]), plain(col["wan_up_mbps"])
		}
	' "$1" 2>/dev/null
}

# ,"speed":{...} for the reply of "data": the tests, and the advertised
# speeds set in ISPy (as text; the pages check them).
speed_json() { # $1=since $2=until
	local f rows
	f=$(ispy_results) || return 0
	rows=$(speed_rows "$f" "$1" "$2") || return 0
	[ -n "$rows" ] || return 0
	printf ',"speed":{"plan_down":%s,"plan_up":%s,"tests":' \
		"$(json_str "$(uci -q get ispy.main.plan_down)")" "$(json_str "$(uci -q get ispy.main.plan_up)")"
	printf '%s\n' "$rows" | json_text
	printf '}'
}

# stdin -> a JSON string
json_text() {
	awk 'BEGIN { printf "\"" } { gsub(/\\/, "\\\\"); gsub(/"/, "\\\""); gsub(/[\001-\037]/, ""); printf "%s\\n", $0 } END { printf "\"" }'
}

do_data() {
	load_config
	local since until k
	since=$(int_or "$1" 0); until=$(int_or "$2" "$(date +%s)")
	printf '{"since":%s,"until":%s' "$since" "$until"
	for k in readings channels events radios; do
		printf ',"%s":' "$k"
		{
			case $k in readings) echo "$READINGS_HEADER" ;; channels) echo "$CHANNELS_HEADER" ;; events) echo "$EVENTS_HEADER" ;; radios) echo "$RADIOS_HEADER" ;; esac
			rows_between "$k" "$since" "$until"
		} | json_text
	done
	# The line-up as it was at SINCE (the last entry of each channel before
	# it) and every change up to UNTIL. On a line whose channels keep
	# losing lock the whole history would outgrow a reply.
	printf ',"channelmap":'
	lineup_between "$since" "$until" | json_text
	speed_json "$since" "$until"
	echo '}'
}

do_status() {
	load_config
	local pid sched=false next="" last="" k v first=1
	pid=$(pgrep -f '/usr/bin/modemhealth daemon' 2>/dev/null | head -n 1)
	[ "$ENABLED" = 1 ] && [ -n "$pid" ] && sched=true
	next=$(cat "$RUN_DIR/next" 2>/dev/null)
	last=$(all_readings | tail -n 1)
	printf '{"version":"%s",' "$VERSION"
	printf '"enabled":%s,"scheduler":%s,"synced":%s,"next_check":%s,"interval":%s,"now":%s,' \
		"$(json_bool [ "$ENABLED" = 1 ])" "$sched" "$(json_bool time_synced)" "$(json_num "$next")" "$INTERVAL" "$(date +%s)"
	printf '"modem_type":%s,' "$(json_str "$MODEM_TYPE")"
	printf '"password_set":%s,"host":%s,"username":%s,"readings_header":%s,"last":%s,"modem":{' \
		"$(json_bool [ -n "$PASSWORD" ])" "$(json_str "$HOST")" "$(json_str "$USERNAME")" "$(json_str "$READINGS_HEADER")" "$(json_str "$last")"
	if [ -s "$DATA_DIR/modem.txt" ]; then
		while IFS='=' read -r k v; do
			[ -n "$k" ] || continue
			[ $first = 1 ] || printf ','
			first=0
			printf '%s:%s' "$(json_str "$k")" "$(json_str "$v")"
		done < "$DATA_DIR/modem.txt"
	fi
	printf '},"export":'
	export_json
	printf ',"drives":['
	first=1
	for k in $(list_drives); do
		[ $first = 1 ] || printf ','
		first=0
		json_str "$k"
	done
	echo ']}'
}

# The GL.iNet panel's web server can give a command neither input nor
# environment, only arguments, which every process on the router can read.
# For a test with a typed password it therefore asks for a root-only file
# (test-input), writes the address, user name and password into it (one per
# line) and gives its name to "test", which reads and removes it.
do_test_input() {
	load_config
	mkdir -p "$RUN_DIR" && chmod 700 "$RUN_DIR" || return 1
	rm -f "$RUN_DIR"/test-input.*   # left by a test that never ran
	mktemp "$RUN_DIR/test-input.XXXXXX"
}

# Log in with the settings in the environment, or in the file from
# test-input (the Settings page sends what is typed, before it is saved),
# and read the status once, without storing anything or touching the kept
# session.
do_test() { # $1=file from test-input (optional)
	local ds us input=$1
	load_config
	if [ -n "$input" ]; then
		case ${input#"$RUN_DIR"/} in
			test-input.*/*|"$input") input= ;;
			test-input.*) [ -f "$input" ] || input= ;;
			*) input= ;;
		esac
		[ -n "$input" ] || { echo '{"ok":false,"reason":"bad_input"}'; return 1; }
		{ IFS= read -r MH_HOST; IFS= read -r MH_USER; IFS= read -r MH_PASSWORD; } < "$input"
		rm -f "$input"
	fi
	HOST=${MH_HOST:-$HOST}; USERNAME=${MH_USER:-$USERNAME}
	[ -n "$MH_PASSWORD" ] && PASSWORD=$MH_PASSWORD
	BASE="https://$HOST"
	RUN_DIR=$(mktemp -d /tmp/modemhealth-test.XXXXXX) || return 1
	chmod 700 "$RUN_DIR"
	# Timestamps must never go below what the modem has already seen.
	cp /var/run/modemhealth/last_ms "$RUN_DIR/" 2>/dev/null
	FAIL_REASON=
	detect_device
	if [ "$DEVICE" = tmobile ]; then
		if [ -s "$RUN_DIR/gateway.json" ] || gw_read; then
			printf '{"ok":true,"type":"tmobile","model":%s,"firmware":%s,"radios":[' \
				"$(json_str "$(clean "$(gw_field '.device.model')")")" "$(json_str "$(clean "$(gw_field '.device.softwareVersion')")")"
			gw_radio_rows 0 | awk -F, 'BEGIN { sep = "" } {
				printf "%s{\"tech\":\"%s\",\"bands\":\"%s\",\"bars\":%s,\"rsrp\":%s,\"rsrq\":%s,\"sinr\":%s}", sep, $2, $3,
					($4 == "" ? "null" : $4), ($5 == "" ? "null" : $5), ($6 == "" ? "null" : $6), ($8 == "" ? "null" : $8); sep = "," }'
			printf '],"registration":%s}\n' "$(json_str "$(clean "$(gw_field '.signal.generic.registration')")")"
		else
			printf '{"ok":false,"type":"tmobile","reason":%s}\n' "$(json_str "$FAIL_REASON")"
		fi
		rm -rf "$RUN_DIR"
		return 0
	fi
	if modem_login && modem_read_status; then
		ds=$(status_field GetCustomerStatusDownstreamChannelInfo CustomerConnDownstreamChannel | awk -F'\\|\\+\\|' '{ print NF - ($0 ~ /\|\+\|$/) }')
		us=$(status_field GetCustomerStatusUpstreamChannelInfo CustomerConnUpstreamChannel | awk -F'\\|\\+\\|' '{ print NF - ($0 ~ /\|\+\|$/) }')
		printf '{"ok":true,"model":%s,"firmware":%s,"downstream":%s,"upstream":%s}\n' \
			"$(json_str "$(clean "$(status_field GetCustomerStatusSoftware StatusSoftwareModelName)")")" \
			"$(json_str "$(clean "$(status_field GetCustomerStatusSoftware StatusSoftwareSfVer)")")" \
			"$(json_num "$ds")" "$(json_num "$us")"
		modem_logout
	else
		printf '{"ok":false,"reason":%s}\n' "$(json_str "$FAIL_REASON")"
	fi
	cp "$RUN_DIR/last_ms" /var/run/modemhealth/ 2>/dev/null
	rm -rf "$RUN_DIR"
}

do_set_password() {
	local pw
	IFS= read -r pw || [ -n "$pw" ] || pw=""
	touch /etc/config/${CONFIG}_auth
	chmod 600 /etc/config/${CONFIG}_auth
	uci -q get "${CONFIG}_auth.main" >/dev/null || uci set "${CONFIG}_auth.main=auth"
	uci set "${CONFIG}_auth.main.password=$pw"
	uci commit "${CONFIG}_auth"
	chmod 600 /etc/config/${CONFIG}_auth
	# Remove a password kept with the other settings by older versions.
	if [ -n "$(uci -q get "$CONFIG.main.password")" ]; then
		uci -q delete "$CONFIG.main.password"
		uci commit "$CONFIG"
	fi
	load_config
	session_drop
	echo '{"ok":true}'
}

# MODEMHEALTH_LIB=1: only define the functions (for probes and tests).
[ "${MODEMHEALTH_LIB:-}" = 1 ] && return 0 2>/dev/null

case "$1" in
	check) with_lock do_check ;;
	history) do_history "$2" ;;
	last) do_last ;;
	logout) do_logout ;;
	daemon) do_daemon ;;
	status) do_status ;;
	data) do_data "$2" "$3" ;;
	test) do_test "$2" ;;
	test-input) do_test_input ;;
	set-password) do_set_password ;;
	restart) with_lock do_restart "$2" "$3" ;;
	export) do_export ;;
	clear) do_clear ;;
	*)
		echo "usage: modemhealth check|history [N]|last|logout|daemon|status|data SINCE [UNTIL]|test [FILE]|test-input|set-password|restart [TRIGGER [DETAIL]]|export|clear" >&2
		exit 2
		;;
esac
