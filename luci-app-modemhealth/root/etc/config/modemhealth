
config modemhealth 'main'
	option enabled '1'
	option modem_type 'auto'
	option interval '5'
	option host '192.168.100.1'
	option username 'admin'
	option timeout '15'
	option ping_host '1.1.1.1'
	option history_days '90'
	option data_dir '/etc/modemhealth'
	option restart_auto '0'
	option restart_down_min '10'
	option restart_signal '0'
	option restart_signal_checks '3'
	option restart_on_unlocked '1'
	option restart_on_out_of_spec '1'
	option restart_max_hour '1'
	option restart_max_day '3'

config limits 'limits'
