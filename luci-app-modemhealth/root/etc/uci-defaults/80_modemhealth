#!/bin/sh
# The modem password lives in modemhealth_auth (root only), apart from the
# settings the web pages load. Move one kept with the settings by 0.1.0-r1.
touch /etc/config/modemhealth_auth
chmod 600 /etc/config/modemhealth_auth /etc/config/modemhealth 2>/dev/null
uci -q get modemhealth_auth.main >/dev/null || { uci set modemhealth_auth.main=auth; uci commit modemhealth_auth; }
old=$(uci -q get modemhealth.main.password)
if [ -n "$old" ]; then
	[ -n "$(uci -q get modemhealth_auth.main.password)" ] || uci set modemhealth_auth.main.password="$old"
	uci commit modemhealth_auth
	uci -q delete modemhealth.main.password
	uci commit modemhealth
fi
chmod 600 /etc/config/modemhealth_auth
# The rpcd plugin and the menu entry: visible without a reboot.
rm -f /tmp/luci-indexcache* 2>/dev/null
rm -rf /tmp/luci-modulecache 2>/dev/null
/etc/init.d/rpcd reload 2>/dev/null

# reload_config only notices changes to configs it already has a checksum
# for; register ours so the first "Save & Apply" restarts the scheduler.
if [ -f /var/run/config.md5 ] && ! grep -q '/var/run/config.check/modemhealth$' /var/run/config.md5; then
	mkdir -p /var/run/config.check
	uci show modemhealth > /var/run/config.check/modemhealth 2>/dev/null
	md5sum /var/run/config.check/modemhealth >> /var/run/config.md5
	rm -rf /var/run/config.check
fi

/etc/init.d/modemhealth enable 2>/dev/null
/etc/init.d/modemhealth restart 2>/dev/null
exit 0
